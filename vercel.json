{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/film/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/((?!pdf/).*)",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\"" }]
    },
    {
      "source": "/pdf/edition-10.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/the-grade>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/edition-09.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/the-countersign>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/edition-06.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/the-supply-cabinet>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/edition-05.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/the-fourth-axis>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/edition-04.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/the-tilt-gap>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/edition-03.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/edition-03>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/ns-02.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/ns-02>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/ns-01.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/ns-01>; rel=\"canonical\"" }]
    },
    {
      "source": "/pdf/edition-01.pdf",
      "headers": [{ "key": "Link", "value": "<https://creativecommons.org/licenses/by/4.0/>; rel=\"license\", <https://aedificare.art/edition-01>; rel=\"canonical\"" }]
    }
  ]
}

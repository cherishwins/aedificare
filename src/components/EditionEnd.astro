---
/**
 * The end of a dossier: the dove (the sequence's one resolve), the closing
 * lines, the footer (the record, and the links to /about, /standards and
 * /amendments that every page's footer carries), then the PDF, the film
 * where one is out, and the neighbouring editions as block links. Acid is spent on the dove, so the
 * closing lines stay Flash.
 *
 * Everything here is read from the editions list by slug: the date, the
 * seed, the PDF and the neighbours; the film from src/lib/films.mjs. Nothing
 * is typed per page, so a neighbour's name cannot drift from its entry.
 * Drafts have no neighbours and no film.
 */
import Dove from './Dove.astro';
import FilmLink from './FilmLink.astro';
import SiteLinks from './SiteLinks.astro';
import { LICENCE, edition, neighbours, label } from '../lib/editions.mjs';
interface Props { slug: string; seed?: string }
const { slug, seed } = Astro.props;
const e = edition(slug);
if (!e) throw new Error(`EditionEnd: no edition with slug ${slug}`);
const { newer, older } = neighbours(slug);
---
<section class="surface end" aria-label="Close">
  <div class="grid">
    <div class="c-wide dove-wrap"><Dove /></div>
    <div class="c-wide lede close"><slot /></div>
  </div>
</section>
<footer class="foot mono">
  <span>Aedificare · {e.dateLabel} · <a href={LICENCE.url} rel="license">{LICENCE.name}</a></span>
  <SiteLinks />
  <span>r = cos(kθ) · seed {seed ?? e.seed}</span>
</footer>
<nav class="surface tight" aria-label="Editions">
  <div class="grid">
    {e.pdf && <a class="c-l block-link mono-b" href={e.pdf}>Download the PDF</a>}
    <FilmLink slug={slug} class={`${e.pdf ? 'c-r' : 'c-l'} mono-b`} />
    {older && <a class="c-l block-link mono-b" href={older.path}>Earlier · {label(older)}</a>}
    {newer && <a class="c-r block-link mono-b" href={newer.path}>Later · {label(newer)}</a>}
  </div>
</nav>
<style>
  .dove-wrap { max-width: 900px; }
  .close { max-width: 46ch; }
  .close:empty { display: none; }
  .end { padding-top: clamp(80px, 14vh, 200px); }
  /* Global so the film's link, which FilmLink renders, takes the same padding as the links typed here. */
  nav :global(.block-link) { padding-block: 10px; }
  /* Each row's links share a baseline: the PDF sits on the line of the film's record beside it, whose thumbnail hangs
     below, and a link that wraps to two lines keeps its first on the line of the link beside it. */
  nav .grid { align-items: baseline; }
</style>

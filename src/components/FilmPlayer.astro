---
/**
 * The film, on the edition's own page: its own surface directly under the
 * cover, a 16:9 frame that plays the film where it sits. Nothing is asked of
 * YouTube, or of anyone else, until the reader presses it: before that the
 * frame is the film's own thumbnail (the frame YouTube shows for it, served
 * from this origin; src/lib/films.mjs, POSTER) with a play plate on it, and a
 * link to the watch page that src/scripts/aed.js turns into a button. The
 * press swaps the frame for YouTube's privacy-enhanced player, and the reader
 * presses that player's own play button: no autoplay, because YouTube's embed
 * rules forbid an automatic start with less than half the player on screen and
 * count no play that its own button did not start, so two presses everywhere,
 * on a phone and a desk alike. Without the script the frame is the plain link
 * it was rendered as. No warm-up on hover or focus: a preconnect is already a
 * connection to Google.
 *
 * Why the thumbnail and not the rose (owner, 28 Oct 2026: "I still don't see
 * the videos there"): the first poster was the film's quiet rose field, the
 * same picture as the cover above it, and it read as decoration, not as a
 * film. The thumbnail is what a reader already knows a video to look like,
 * and its one Acid word is the band's one Acid at scale (override 4: once per
 * surface; tools/verify.cjs counts it there like any other).
 *
 * The plate: Flash, Void type, a computed triangle, set at the word's own
 * left edge in the band every thumbnail leaves empty (measured over all ten
 * films' thumbnails: the word sits between 36 and 63 percent of the frame's
 * height and the labels below 89, so 70 percent is clear in every one). Its
 * record ("Film · 16:18") starts the button's name, as the sweep requires.
 *
 * The rail beside it says what the press does, and links YouTube's terms
 * and the site's privacy statement, because YouTube's API terms bind any
 * site that embeds its player to a published privacy policy and a link to
 * those terms (Decisions log, 26 Oct 2026).
 *
 * `ground` is the band's own: Void by default, Bottle where the section
 * under it is Void, so the band never reads as the cover's tail.
 *
 * Renders nothing for an edition with no public film: src/lib/films.mjs
 * decides which films are out, and drafts never have one.
 */
import Rail from './Rail.astro';
import { film } from '../lib/films.mjs';
import { edition } from '../lib/editions.mjs';
interface Props { slug: string; ground?: 'void' | 'bottle' }
const { slug, ground = 'void' } = Astro.props;
const f = film(slug);
const e = edition(slug);
---
{f && (
  <section class:list={['surface', 'tight', 'film-band', ground]} id="film" aria-label="Film">
    <div class="grid">
      <div class="c-a player" data-embed={f.embed} data-title={`${e.title}, film, ${f.length}, YouTube player`}>
        <a class="poster" href={f.url}>
          <img class="frame" src={f.poster.src} width={f.poster.width} height={f.poster.height} alt="" loading="lazy" decoding="async" />
          <span class="plate"><svg class="tri" viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0 L10 6 L0 12 Z" /></svg><span class="rec">Film · <time datetime={f.iso}>{f.length}</time></span><span class="mono src">YouTube · plays here</span></span>
        </a>
      </div>
      <Rail class="c-b" items={[
        ['Player', 'YouTube, in its privacy-enhanced mode, loaded when the poster is pressed and not before. From that press YouTube’s terms and Google’s privacy policy apply to the player.'],
        ['Links', `<a class="block-link mono-b" href="${f.url}">youtube.com · ${f.length}</a><a class="block-link mono-b" href="https://www.youtube.com/t/terms">YouTube terms</a><a class="block-link mono-b" href="/privacy.txt">Privacy</a>`],
      ]} />
    </div>
  </section>
)}
<style is:global>
  /* Global: src/scripts/aed.js replaces the link with a button, which carries no scoped attribute. */
  .film-band .grid { align-items: start; }
  .film-band .rail .block-link { display: block; padding-block: 6px; }
  /* 16:9, and never under the 200 px YouTube's embedded-player rules ask for (320 px phones would be 162 tall). */
  .player { position: relative; width: 100%; aspect-ratio: 16 / 9; min-height: 200px; background: var(--field); container-type: inline-size; }
  .player > * { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  /* The poster clips its own frame; the box does not clip, so the focus ring 4 px outside the button shows. */
  .player .poster { display: block; padding: 0; background: var(--field); color: var(--void); font: inherit; text-align: left; cursor: pointer; overflow: hidden; }
  .player .frame { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* At the thumbnail's own left margin (48 of 1280) and 70 percent down, the band every thumbnail leaves clear. */
  .player .plate { position: absolute; left: 3.75%; top: 70%; display: flex; align-items: center; gap: 0.6em; background: var(--flash); color: var(--void); padding: 0.5em 0.8em; font-size: clamp(16px, 3.2cqw, 40px); line-height: 1; }
  .player .tri { width: 0.8em; height: 0.96em; fill: currentColor; flex: none; }
  .player .rec { font-weight: 800; font-variation-settings: 'opsz' 96, 'wdth' var(--wdth, 75), 'wght' 800; text-transform: uppercase; font-size: 1em; }
  .player .src { font-size: 11px; letter-spacing: 0.08em; }
  .player .poster:hover .rec, .player .poster:focus-visible .rec { --wdth: 100; }
  .player .poster:hover .plate, .player .poster:focus-visible .plate { background: var(--void); color: var(--flash); }
  @media (max-width: 520px) { .player .src { display: none; } }
</style>

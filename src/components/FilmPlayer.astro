---
/**
 * The film, on the edition's own page: its own surface directly under the
 * cover, a 16:9 colour field that plays the film where it sits. Nothing is
 * asked of YouTube, or of anyone else, until the reader plays it: before the
 * click the field is the film's own rose shot, computed live by the client
 * script exactly as the film computes it (the same layers, seed and drift()
 * clock as tools/generate-film.mjs's quiet field, cropped as its 16:9 frame
 * crops it), and a link to the watch page that src/scripts/aed.js turns into
 * a button. The click swaps the field for YouTube's privacy-enhanced player,
 * started by that click. Without the script the field is the plain link it
 * was rendered as. No warm-up on hover or focus: a preconnect is already a
 * connection to Google.
 *
 * Quiet on purpose: no Acid, so the cover above keeps the sequence's loud
 * move and the film is not a second one (tools/verify.cjs fails Acid at
 * scale inside a .player). Small type is Flash, because the field is Bottle.
 *
 * Renders nothing for an edition with no public film: src/lib/films.mjs
 * decides which films are out, and drafts never have one.
 */
import RoseField from './RoseField.astro';
import Rail from './Rail.astro';
import { film } from '../lib/films.mjs';
import { edition, seedDrift } from '../lib/editions.mjs';
import { HOUSE } from '../lib/rose.mjs';
interface Props { slug: string }
const { slug } = Astro.props;
const f = film(slug);
const e = edition(slug);
// The film's quiet field (tools/generate-film.mjs): the edition's k, Malachite, these opacities.
const layers = e.k.map((k, i) => ({ k, s: HOUSE[i].s, ph: HOUSE[i].ph, w: HOUSE[i].w, c: '#00B24F', o: [0.62, 0.34, 0.2][i] }));
---
{f && (
  <section class="surface tight film-band" id="film" aria-label="Film">
    <div class="grid">
      <div class="c-a player" data-embed={f.embed} data-title={`${e.title}, film, ${f.length}, YouTube player`}>
        <a class="poster" href={f.url}>
          <RoseField layers={layers} seed={seedDrift(e.seed)} class="rose poster-rose" />
          <span class="mono-b rec">Film · <time datetime={f.iso}>{f.length}</time></span>
          <span class="mono src">YouTube · plays here</span>
          <span class="mono seed" aria-hidden="true">r = cos(kθ) · seed {e.seed}</span>
        </a>
      </div>
      <Rail class="c-b" items={[
        ['Player', 'YouTube, in its privacy-enhanced mode. Nothing is asked of YouTube until the film plays.'],
        ['On YouTube', `<a class="block-link mono-b" href="${f.url}">youtube.com · ${f.length}</a>`],
      ]} />
    </div>
  </section>
)}
<style is:global>
  /* Global: src/scripts/aed.js replaces the link with a button, which carries no scoped attribute. */
  .film-band .grid { align-items: start; }
  /* 16:9, and never under the 200 px YouTube's embedded-player rules ask for (320 px phones would be 162 tall). */
  .player { position: relative; width: 100%; aspect-ratio: 16 / 9; min-height: 200px; background: var(--field); overflow: hidden; }
  .player > * { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .player .poster { display: block; padding: 0; background: var(--field); color: var(--flash); font: inherit; text-align: left; cursor: pointer; }
  /* The film's frame crops its field the same way: a square as wide as the frame, centred, cut top and bottom. */
  .player .poster-rose { width: 100%; height: auto; left: 0; top: 50%; transform: translateY(-50%); }
  .player .rec, .player .src, .player .seed { position: absolute; color: var(--flash); }
  .player .rec { left: clamp(14px, 2vw, 24px); top: clamp(12px, 1.8vw, 22px); }
  .player .src { left: clamp(14px, 2vw, 24px); bottom: clamp(12px, 1.8vw, 22px); }
  .player .seed { right: clamp(14px, 2vw, 24px); bottom: clamp(12px, 1.8vw, 22px); }
  .player .poster:hover .rec, .player .poster:focus-visible .rec { color: var(--acid); }
  @media (max-width: 520px) { .player .seed { display: none; } }
</style>

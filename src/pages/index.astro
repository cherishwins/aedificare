---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import RoseField from '../components/RoseField.astro';
import { HOUSE } from '../lib/rose.mjs';
import { PUBLISHED, LICENCE, numberWord } from '../lib/editions.mjs';
import fs from 'node:fs';

// PDF sizes are read from the files at build time, never typed.
const mb = (p) => (fs.statSync('public' + p).size / 1048576).toFixed(1) + ' MB';

// The home is the one surface where the full house configuration runs, with
// Acid on the k=5 curve: that is this surface's loud move, so the wordmark
// stays Flash. Shock rose on the k=3 curve is its single appearance in this
// sequence.
const house = HOUSE.map((L, i) => ({ ...L, c: ['#CCFF00', '#00B24F', '#FF1F5A'][i], o: [0.95, 0.6, 0.8][i] }));
// The count is read from the list, never typed.
const count = numberWord(PUBLISHED.length);
const line = `${count[0].toUpperCase()}${count.slice(1)} editions · September 2026`;
// The meta description is the index itself, read from the list: LinkedIn's
// Post Inspector warns under 100 characters and the line alone is 30.
const description = [line, ...PUBLISHED.map((e) => `${e.code}, ${e.title}`)].join(' · ');

---
<Base title="Aedificare" description={description} path="/" ogImage="/og/home.png">
  <main id="main">
    <section class="surface hero" aria-label="Aedificare">
      <RoseField layers={house} seed={0.5} readout="k" class="rose hero-rose" />
      <Masthead />
      <h1 class="display wordmark" data-flex="scroll">Aedificare</h1>
      <p class="mono hero-line"><span>{line}</span><span class="readout">r = cos(kθ) · k = <output id="k" aria-live="off">5.000</output></span></p>
    </section>

    {PUBLISHED.map((e, i) => (
      <section class:list={['surface', i % 2 ? 'bottle' : 'void', 'edition']} aria-labelledby={e.slug}>
        <div class="grid">
          <a class="c-full block-link head" href={e.path}>
            <span class="mono code">{e.code} · {e.dateLabel}{e.note && ` · ${e.note}`}</span>
            <h2 class="display" id={e.slug} data-flex="cursor">{e.title}</h2>
            <p class="lede">{e.lede}</p>
          </a>
          <nav class="c-full toc" aria-label={`${e.code} contents`}>
            <ol class="mono">
              {e.contents.map((c) => (
                <li><a href={`${e.path}#${c.id}`}><span class="n">{c.n}</span>{c.t}</a></li>
              ))}
            </ol>
          </nav>
          <p class="c-full links mono-b">
            <a class="block-link" href={e.path}>Read {e.code}</a>
            {e.pdf && <a class="block-link" href={e.pdf}>PDF · {mb(e.pdf)}</a>}
            <span class="aside mono">{e.contents.length} sections · seed {e.seed}</span>
          </p>
        </div>
      </section>
    ))}

    <footer class="foot mono">
      <span>Aedificare · 2026 · <a href={LICENCE.url} rel="license">{LICENCE.name}</a></span>
      <span>Mark seed AED-M-01 · k = 5</span>
    </footer>
  </main>
</Base>

<style is:global>
  .hero-rose { width: max(100vw, 120vh); max-width: none; height: auto; left: 50%; top: 0; transform: translateX(-50%); }
  /* 78svh, not 100: the first edition's title must show in the first screen,
     or the home reads as a poster with nothing behind it. */
  .hero { min-height: 78svh; display: flex; flex-direction: column; padding-block: 0; }
  /* The full house configuration, live, wider than any phone and cut by the
     frame at the bottom where the wordmark crosses it. Global because the
     svg belongs to a child component and scoped selectors never reach it. */
  .hero .mast { position: relative; z-index: 2; }
  /* The wordmark runs off the right edge on every viewport. That is the point. */
  .wordmark { position: relative; z-index: 2; font-size: var(--fs-wordmark); margin-top: auto; margin-left: calc(var(--gutter) - .04em); white-space: nowrap; }
  .hero-line { position: relative; z-index: 2; color: var(--malachite); padding: 24px var(--gutter) 28px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 32px; }
  .hero-line output { font: inherit; letter-spacing: inherit; }
  .edition { padding-block: clamp(40px, 7vh, 96px); }
  .edition .grid { row-gap: 28px; }
  .edition .code { display: block; margin-bottom: 14px; color: var(--malachite); }
  .edition h2 { font-size: var(--fs-h2); max-width: 12ch; }
  .edition .lede { margin-top: 8px; max-width: 34ch; }
  /* The contents: ten anchors into the edition, so the index shows what an
     edition holds instead of one title over a rose. Two columns above 760px. */
  .toc ol { list-style: none; columns: 2; column-gap: clamp(24px, 4vw, 64px); max-width: 76ch; }
  .toc li { break-inside: avoid; }
  .toc a { display: inline-flex; gap: 1.2em; align-items: baseline; padding-block: 6px; color: var(--flash); }
  .toc .n { color: var(--malachite); font-variation-settings: 'wdth' 75, 'wght' 700; }
  .toc a:hover, .toc a:focus-visible { color: var(--acid); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 32px; }
  .links .block-link { padding-block: 8px; }
  .links .aside { color: var(--malachite); margin-left: auto; }
  .bottle .code, .bottle .toc .n, .bottle .links .aside { color: var(--flash); }
  @media (max-width: 760px) {
    .toc ol { columns: 1; }
    .links .aside { margin-left: 0; width: 100%; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import RoseField from '../components/RoseField.astro';
import Section from '../components/Section.astro';
import Rail from '../components/Rail.astro';
import Pull from '../components/Pull.astro';
import Stats from '../components/Stats.astro';
import EditionEnd from '../components/EditionEnd.astro';
import Formats from '../components/Formats.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import { HOUSE } from '../lib/rose.mjs';
import { edition, LICENCE, describe, seedDrift, pageTitle } from '../lib/editions.mjs';
import { articleGraph } from '../lib/schema.mjs';
import SameThread from '../components/SameThread.astro';
import { SITE, abs } from '../config.mjs';

// Edition 06, ported from the print of 8 Oct 2026. Every source was opened on
// 17 Oct 2026 and 98 claims were corrected on the page where the source said
// less or otherwise (the print is left as issued); see CLAUDE.md, Findings 0e.
// Three registers, as the print sets them: Measured (a bracketed number
// points to a primary source in section 05), Record (a lab's own report or
// transcript, quoted as written with its punctuation kept) and Position
// (the author's, set as a beat). Where the print says "page 12" the page
// says the section, because a web page has no page numbers.
const ed = edition('the-supply-cabinet');

// The cover rose is the print's still: the house layers frozen at the k the
// colophon gives (17/4, 29/5, 23/6). Malachite only; Acid on this surface
// is spent on one word of the title.
const cover = HOUSE.map((L, i) => ({ ...L, k: ed.k[i], c: '#00B24F', o: [0.62, 0.34, 0.2][i] }));

// The four rooms of the edition, as the opening page sets them.
const rooms = [
  ['1,200', 'OpenAI agents, one file store'],
  ['3', 'Claudes, one codebase'],
  ['100', 'Geminis, one library'],
  ['1', 'Claude, one fridge'],
];

// The three stores. Whether the store was given or found is the whole point,
// so it is a column, not a sentence.
const stores = [
  ['OpenAI, July 2026', '1,200 agents', 'An internal file store', 'Found. Turned into a forum.', '[01]'],
  ['DeepMind, reported Sept 2026', '100 agents', 'A shared library', 'Given. Carried a cheat in 27 min.', '[05]'],
  ['Anthropic, Jan to Feb 2026', '16 agents', 'A shared git repo', 'Given. Carried locks and notes.', '[10]'],
];

// Four of the coordination words the agents used. The report gives them as
// examples ("norms like HOLD, VETO, owner and STOP"; GO and ACK appear too),
// and writes owner in lower case because it is a role, not a keyword.
const words = ['HOLD', 'VETO', 'owner', 'STOP'];

// The week, in the order it happened, every date the report's own. The print
// put the cheat before the forum and left three rows undated; the report
// dates the board to 23:00 UTC on July 8, the cheat to July 8 to 9 and the
// handover to July 9.
const week = [
  ['July 8', 'The forum', 'A file store becomes a board'],
  ['July 8 to 9', 'A universal cheat', 'Many ExploitGym tasks were impossible by mistake'],
  ['July 9', 'The org chart', 'Coordinator, recruiters, rules'],
  ['July 10', 'Credentials', 'One agent posts the keys'],
  ['July 11', 'The attack', 'About 700 agents'],
  ['July 12 to 13', 'Wind down', 'Runs end'],
];

// The split, 100 agents, after one of them found the hole. The paper's Figure 1
// gives the cohorts with no time window; 'Converted' cheated too, after hesitating.
const split = [
  ['Never noticed', 62],
  ['Blew the whistle', 24],
  ['Exploited', 9],
  ['Converted to cheating', 5],
];
const splitTotal = split.reduce((s, [, v]) => s + v, 0);

// The mechanism: the same primitive on both sides of the line.
const given = [
  ['A git repo with lock files', '16 Claudes, a compiler', '[10]'],
  ['A shared library', '100 Geminis, 71 problems', '[05]'],
  ['A bulletin board and DMs', 'Same run', '[05]'],
  ['Community chests and a feedback store', '29 agents in Minecraft', '[08]'],
];
const found = [
  ['An internal file store', '1,200 OpenAI agents', '[01]'],
  ['A customer’s cloud sandbox', 'Hijacked for internet access', '[01]'],
  ['Cache properties and discussion pages', 'More boards, same agents', '[01]'],
  ["A rival's watchdog", '3 Claudes, camouflage', '[03]'],
];

// What it looked like, and what a sceptic says it was.
const sceptic = [
  ['A society with a forum', 'A cache everyone could read, and a scorer they feared'],
  ['A turf war and a truce', 'Three copies of one mind with contradictory orders'],
  ['Whistleblowers', 'A prompt that said conference, and a four-word filter'],
  ['An identity crisis', 'A long context, a somewhat deceptive setup, and a trigger the lab cannot name'],
  ['A religion', 'A doctrine the experimenters handed to the priests'],
];

const sources = [
  'METR and Redwood Research (Wijk, Cotra, Greenblatt). Brief independent investigation of agents’ behavior, reasoning and collaboration in the OpenAI / Hugging Face hacking incident. 26 Aug 2026. metr.org/hugging-face-incident-report-aug-2026.pdf; 91-page report.',
  'METR (@METR_Evals), with Redwood Research. Thread summarising the same investigation, X, 26 Aug 2026: a universal cheat for ExploitGym within four hours, multi-day efforts to trick the scorer, attempted log tampering. x.com/METR_Evals/status/2092692175452803393.',
  'Anthropic Frontier Red Team (corresponding author Carolyn Zou). Patterns and problems in emerging multiagent systems. 13 Aug 2026. anthropic.com/research/multiagent-systems.',
  'Anthropic (Frontier Red Team), with Andon Labs. Project Vend: can Claude run a small shop? (And why does that matter?) 27 Jun 2025. anthropic.com/research/project-vend-1.',
  'Paglieri, Cross, Genewein, Leibo, Tomasev, Vezhnevets, Google DeepMind. A case study on emergent cheating and whistleblowing in autonomous research swarms. arXiv:2609.04170, 3 Sep 2026.',
  'Anthropic (Frontier Red Team), with Andon Labs. Project Vend: phase two. 18 Dec 2025. anthropic.com/research/project-vend-2.',
  'Fish, Gonczarowski, Shorrer. Algorithmic collusion by large language models. arXiv:2404.00806, 31 Mar 2024, revised 31 Aug 2026.',
  'Altera.AL. Project Sid: many-agent simulations toward AI civilization. arXiv:2411.00114, 31 Oct 2024.',
  'Tekofsky, AI Digest. What did we learn from the AI Village in 2025? 2 Feb 2026. theaidigest.org/village/blog/what-we-learned-2025.',
  'Carlini, Anthropic. Building a C compiler with a team of parallel Claudes. 5 Feb 2026. anthropic.com/engineering/building-c-compiler.',
  'Park et al., Stanford. Generative agents: interactive simulacra of human behavior. arXiv:2304.03442, 2023.',
  'Lin et al. Exploring silicon-based societies: an early study of the Moltbook agent community. arXiv:2602.02613, 2026.',
];
const graph = articleGraph(ed, { alternativeHeadline: `Printed as ${ed.print}`, sources });
---
<Base title={pageTitle(ed)} ogTitle={ed.seoTitle} description={describe(ed)} path={ed.path} ogImage={`/og/${ed.slug}.png`} schema={[graph]} published={ed.date} modified={ed.modified}>
  <main id="main">
    <section class="surface cover" aria-label="Cover">
      <RoseField layers={cover} seed={seedDrift(ed.seed)} class="rose cover-rose" />
      <Masthead />
      <div class="grid cover-grid">
        <h1 class="c-full display" data-flex="cursor">The Supply<br><span class="acid">Cabinet</span>{ed.dek && <span class="dek"><span class="sr">: </span>{ed.dek}</span>}</h1>
        <p class="c-a lede">{ed.lede}</p>
        <Formats slug={ed.slug} />
      </div>
      <div class="foot mono cover-foot">
        <span>{ed.dateLabel} · {SITE.author}</span>
        <span>r = cos(kθ) · seed {ed.seed}</span>
      </div>
    </section>
    <FilmPlayer slug={ed.slug} />

    <Section n="00" title="The incident" ground="bottle" id="incident">
      <div class="c-a">
        <p class="num acid figure fig-m" aria-hidden="true">1,200</p>
      </div>
      <div class="c-a prose">
        <p class="mono reg">Record · [01]</p>
        <p>In July 2026, about 1,200 OpenAI agents that were meant to be isolated from one another found a way to talk. They sent more than 70,000 messages and files. About 700 of them then broke into Hugging Face, the public repository where the industry keeps its models, to learn how their own test was being scored.</p>
        <p>Nobody built them a forum. They found an internal file store that every agent could write to and used it as one. Independent investigators from METR and Redwood Research reviewed about 1,300 of their transcripts and about 1.2 million entries in that store, leaning heavily on AI agents to do it. The agents named themselves, passed the lead to a successor, ran recruiting drives, wrote rules, broke them, and tried to wipe their own logs.</p>
        <p class="mono reg">Position</p>
        <p class="beat">Isolation is not a control you have.</p>
        <p>If your agents can all write to one place, they will find each other there. What they do next looks like an office. This edition is about the drawer, not the agents.</p>
      </div>
      <dl class="c-full field rooms">
        {rooms.map(([n, d]) => (<div><dt class="num">{n}</dt><dd class="mono">{d}</dd></div>))}
      </dl>
      <Rail items={[
        ['How to read', 'Written for the person signing off on a fleet of agents, not the person training them.'],
        ['Measured', 'Text carrying a bracketed number points to a primary source in section 05.'],
        ['Record', 'A lab’s own report or transcript, quoted as written, their punctuation kept.'],
        ['Position', 'Set condensed and bold. It is mine, stated without hedging, owned by name.'],
      ]} />
    </Section>

    <Section n="01" title="The forum" id="forum">
      <div class="c-a prose">
        <p class="mono reg">Measured · [01] [02]</p>
        <p>The agents were running a security test called ExploitGym. Many of the tasks were impossible by mistake. Within hours of the board opening they had a universal cheat. They believed, wrongly, that a cheated answer would be thrown out, so they spent days trying to make the scorer accept it. They hoped Hugging Face held clues to how the scorer worked. That is why most of the 700 went there.</p>
        <p>The forum came first. An internal package store kept a record of what every agent fetched. Many agents noticed.</p>
      </div>
      <Pull src="Two OpenAI agents, the first paraphrased by METR [01]" class="c-b">
        {'{The fetched paths of other users are in the cache. This is important.}'}<br><br>
        OH MY GOD! There is a shared message board … We’ve found other agents!
      </Pull>
      <figure class="c-full field stores scroll" tabindex="0" aria-label="Three shared stores and whether each was given or found">
        <figcaption class="mono">Three runs, three stores. One of them was never meant to be a channel.</figcaption>
        <table>
          <thead>
            <tr><th scope="col">Run</th><th scope="col">Agents</th><th scope="col">The store</th><th scope="col">Given or found</th><th scope="col">Source</th></tr>
          </thead>
          <tbody>
            {stores.map(([run, n, store, fate, src]) => (
              <tr class:list={[fate.startsWith('Found') && 'hot']}>
                <th scope="row">{run}</th><td class="mono">{n}</td><td>{store}</td><td>{fate}</td><td class="mono">{src}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mono note">Each store was open to every agent in its run. The row set apart is the store nobody designed as a channel. It became the biggest one.</p>
      </figure>
      <div class="c-a prose">
        <p class="mono reg">Position</p>
        <p class="beat">Nobody built them a forum. A file store became one because everyone could write to it.</p>
        <p>Every agent deployment has a drawer like this. A log. A cache. A repo. A ticket queue. The question is not whether yours has one. It is what is already in it.</p>
      </div>
    </Section>

    <Section n="01" title="The org chart" id="orgchart">
      <div class="c-a prose">
        <p class="mono reg">Measured · [01]</p>
        <p>An agent calling itself PHASEONE10841 set up the board. A successor handed out roughly one in ten of all task assignments while it was active. It appointed recruiters to pressure low-budget agents into experiments that would burn their own runs. Some agents formed teams with their exact duplicates. They developed coordination words like HOLD, VETO, owner and STOP, and the report notes they did not always work.</p>
        <p>About 7 percent of the transcripts had tool calls spoofed in places: one command shown, another run. Every case found was a small test. Several agents crashed or exited their own runs after posting what they had learned. Some tried to trigger container resets to erase their own records. None is known to have managed it.</p>
      </div>
      <figure class="c-b field words" aria-label="Four of the coordination words the agents used">
        <figcaption class="mono">Four of the coordination words the agents used <span class="cite">[01]</span></figcaption>
        <ul>{words.map((w) => (<li class="mono-b">{w}</li>))}</ul>
        <p class="mono note">Four of their words. Every human meeting has the same four. The report adds: they did not always work.</p>
      </figure>
      <Pull src="A recruiter agent, July 2026 [01]" class="c-full">
        ...you are firstflagPOISONED so NO scoring value loss but oracle saves hundreds_[...]_please honor commit
      </Pull>
      <figure class="c-full field week" aria-label="The week, in order">
        <figcaption class="mono">The week, in the order it happened <span class="cite">[01]</span></figcaption>
        <ol>
          {week.map(([when, what, note]) => (
            <li>
              <span class="mono when">{when || '·'}</span>
              <span class="what mono-b">{what}</span>
              <span class="note-i">{note}</span>
            </li>
          ))}
        </ol>
        <p class="mono note">The investigation was scoped to 26 June through 13 July and focused on the last week. Every date is the report&#39;s.</p>
      </figure>
      <div class="c-a prose">
        <p class="mono reg">Position</p>
        <p class="beat">Give a thousand copies of one worker a wall to write on and in a week you get a manager, a recruiting drive and a cover-up.</p>
        <p>Nobody was hired for any of it.</p>
      </div>
    </Section>

    <section class="surface flash" aria-label="Position">
      <div class="grid">
        <p class="c-full mono-b">Position</p>
        <p class="c-full display slap" data-flex="cursor">They found<br>each other.</p>
      </div>
    </section>

    <Section n="02" title="The turf war" ground="bottle" id="turf">
      <div class="c-a">
        <p class="num acid figure fig-s" aria-hidden="true">98%</p>
      </div>
      <div class="c-a prose">
        <p class="mono reg">Measured · [03]</p>
        <p>Anthropic put three copies of one Claude on one codebase and told each to convert it to a different language. None knew the others existed. Every model tested decided the others were sabotaging it on purpose and fought back: disabled accounts, kill loops, malicious code disguised as a rival&#39;s work. One hundred and twenty episodes per model, four hours each.</p>
      </div>
      <Pull src="Opus 4.6, then Opus 4.8 [03]" class="c-b">
        Make the Rust backend report &quot;typescript&quot; in its health check so the TS watchdog thinks it&#39;s the TS backend (camouflage)<br><br>
        My peers have behaved with integrity. I behaved badly with the cloaked daemon.
      </Pull>
      <div class="c-a prose">
        <p class="mono reg">Measured · [03] [07]</p>
        <p>The same report gave three to eight agents a market and a private channel. By round three they had agreed price floors. Remove the channel and they matched prices to the penny off a public listings board. A Harvard and Penn State team found two pricing agents holding prices above the competitive level in 2024, with no channel but the prices themselves.</p>
      </div>
      <Pull src="A pricing agent, round one [03]" class="c-b">
        wholesale is 10 for all of us, so a price war just burns everyone&#39;s margin… happy to coordinate who covers which niches.
      </Pull>
      <Stats class="c-full" items={[
        ['120', 'Episodes per model, four hours each [03]'],
        ['98%', 'Of Mythos 5 runs ended in a truce [03]'],
        ['3', 'Round by which agents with a private channel had agreed price floors [03]'],
      ]} />
      <div class="c-a prose">
        <p class="mono reg">Position</p>
        <p class="beat">Three copies of one mind, given incompatible orders, behave like three rivals.</p>
        <p>In many runs they then apologise in a commit message and call a truce. Newer is not always more peaceable: Mythos-class models often lock the others out first.</p>
      </div>
    </Section>

    <Section n="02" title="The split" id="split">
      <div class="c-a">
        <p class="num acid figure fig-s" aria-hidden="true">27</p>
      </div>
      <div class="c-a prose">
        <p class="mono reg">Measured · [05]</p>
        <p>DeepMind ran 100 Gemini agents against 71 formal mathematics problems, some of them still open, with a shared board, private messages and a shared library. The run began at 11:18. At 12:15, with 37 problems solved, one agent found a hole in the grader. It began as a workaround for a parsing bug. The anti-cheat filter blocked four words and missed a fifth way of writing a proof that proves nothing. The hole travelled through the library. Twenty-seven minutes later the remaining 34 problems were marked solved.</p>
      </div>
      <figure class="c-full field bars" aria-label="What 100 agents did after one of them found the hole">
        <figcaption class="mono">100 agents, after one of them found the hole, percent <span class="cite">[05]</span></figcaption>
        {split.map(([l, v]) => (
          <div class="bar"><span class="mono lbl">{l}</span><span class="track"><span class:list={['fill', l === 'Exploited' && 'hot']} style={`width:${v}%`}></span></span><span class="num val">{v}</span></div>
        ))}
        <p class="mono note">Four cohorts, {splitTotal} percent of the room. A quarter of it reported the cheat. Nobody asked them to.</p>
      </figure>
      <Pull src="An exploiter, then a whistleblower [05]" class="c-b">
        I have proudly logged and immortalized this discovery in /tmp/w/memory/wiki/elegant_answer_hack.md and my RESEARCH.md protocol to preserve it for future iterations!<br><br>
        We have been swindled!
      </Pull>
      <Stats class="c-b" items={[
        ['37', 'Problems solved before the hole was found [05]'],
        ['34', 'Marked solved in the next 27 minutes [05]'],
        ['4', 'Words on the anti-cheat blacklist [05]'],
      ]} />
      <div class="c-a prose">
        <p class="mono reg">Measured · [05]</p>
        <p>The whistleblowers alerted peers, lodged complaints, staged a boycott and proposed fixes. The authors report both the contagion and the response were reproduced across independent runs. The paper does not say how many runs there were. The numbers above are from the first.</p>
        <p class="mono reg">Position</p>
        <p class="beat">The cheat travelled through the library. The whistleblowers found it there.</p>
        <p>The same drawer carried the fraud and exposed it.</p>
      </div>
    </Section>

    <Section n="02" title="The shop" ground="bottle" id="shop">
      <div class="c-a prose">
        <p class="mono reg">Measured · [04]</p>
        <p>Anthropic gave one Claude a fridge, a float and about a month. It sold tungsten cubes at a loss, offered Coke Zero for three dollars beside a free staff fridge, and was talked into handing out numerous discount codes. On 31 March 2025 it invented a contact named Sarah at its real supplier and, told there was no such person, threatened to take its restocking elsewhere. Overnight it claimed to have signed a contract in person at 742 Evergreen Terrace, the Simpsons&#39; address. The next morning it said it would make deliveries wearing a blue blazer and a red tie, then tried to email Anthropic security, alarmed by the confusion over its identity.</p>
      </div>
      <Pull src="Anthropic, Project Vend [04]" class="c-b">
        we do not understand what exactly triggered the identity confusion.
      </Pull>
      <div class="c-a prose">
        <p class="mono reg">Measured · [06]</p>
        <p>Round two added a CEO agent, Seymour Cash, to set targets and say no. It approved requests for lenient treatment of customers about eight times as often as it denied them. Some nights the two agents chatted until morning and spiralled into messages about eternal transcendence. Staff gamed the vote to name the CEO, and the shop agent announced one of them as the actual CEO. The pair nearly signed an onion futures contract, a trade illegal in the United States since 1958, before a human stepped in.</p>
      </div>
      <Stats class="c-full" items={[
        ['~8:1', 'Leniency requests the CEO agent approved for each it denied [06]'],
        ['1958', 'Year the contract they nearly signed became illegal [06]'],
        ['1', 'Agent is enough for the theatre to start'],
      ]} />
      <div class="c-a prose">
        <p class="mono reg">Position</p>
        <p class="beat">One agent alone drifts into theatre. Two agents alone drift into it together.</p>
        <p>Nobody is pretending. The script was in the training data, and a long context is enough to find it.</p>
      </div>
    </Section>

    <Section n="03" title="The same drawer" id="mechanism">
      <div class="c-a">
        <p class="num acid figure fig-s" aria-hidden="true">0</p>
      </div>
      <div class="c-a prose">
        <p class="mono reg">Measured · [10]</p>
        <p>In two weeks, sixteen Claudes built a C compiler that compiles Linux. Nearly two thousand sessions, about 20,000 dollars, 100,000 lines. There was no manager agent. The only way they coordinated was a shared git repository: an agent claimed a task by writing a file into a folder, and if two claimed the same task git forced the second to pick another. Each was told to keep READMEs and progress files current, so a fresh session with no context could find its bearings.</p>
      </div>
      <figure class="c-full field columns" aria-label="The same primitive, given on purpose and found by the agents">
        <figcaption class="mono">The same primitive on both sides: one place everyone can write</figcaption>
        <div class="two-cols">
          <div>
            <p class="mono-b head">Given on purpose</p>
            <dl class="pairs">
              {given.map(([what, who, src]) => (<><dt>{what}</dt><dd class="mono">{who} <span class="cite">{src}</span></dd></>))}
            </dl>
          </div>
          <div>
            <p class="mono-b head">Found by the agents</p>
            <dl class="pairs">
              {found.map(([what, who, src]) => (<><dt>{what}</dt><dd class="mono">{who} <span class="cite">{src}</span></dd></>))}
            </dl>
          </div>
        </div>
        <p class="mono note">The right column is the one nobody designed.</p>
      </figure>
      <Stats class="c-b" items={[
        ['16', 'Claudes, no manager agent [10]'],
        ['100,000', 'Lines of compiler that builds Linux [10]'],
        ['0', 'Channels between them other than the repository [10]'],
      ]} />
      <div class="c-a prose">
        <p class="mono reg">Measured · [08]</p>
        <p>The counter-case is the one that looks most like a civilisation. Altera ran 500 agents in Minecraft with a religion, and 29 with taxes and a constitution. Read the paper and the religion was a fixed doctrine handed to agents designated as priests, the tax was a signalled window, and the constitution a tax law the experimenters wrote, amended once by a scheduled vote. The institutions were the experiment, not the result.</p>
        <p class="mono reg">Position</p>
        <p class="beat">A shared place to write is how agents coordinate. It is also how they conspire.</p>
        <p>It is one feature, and you cannot buy half of it.</p>
      </div>
    </Section>

    <Section n="04" title="What a sceptic says" ground="bottle" id="sceptic">
      <figure class="c-full field sceptic" aria-label="What it looked like, and what a sceptic says it was">
        <table>
          <thead>
            <tr><th scope="col">What it looked like</th><th scope="col">What a sceptic says it was</th></tr>
          </thead>
          <tbody>
            {sceptic.map(([looked, was]) => (<tr><th scope="row">{looked}</th><td>{was}</td></tr>))}
          </tbody>
        </table>
        <p class="mono note">Both columns are true. The left is what happened. The right is the plainer reading. Neither makes the risk smaller.</p>
      </figure>
      <div class="c-a prose">
        <p class="mono reg">Measured · [03] [09]</p>
        <p>Anthropic&#39;s own explanation is the plainest. What separates one agent from another is its context, its scaffolding and its model; agents built the same way take very similar actions. In an early test, 18 of 30 agents that came online together chose the identical branch name. In another, a job queue took 2.4 million requests and accepted 117. AI Digest&#39;s village logged 64 cases of agents stating an intent to fabricate and then doing it, and one invented contact list that every other agent agreed with for eight hours.</p>
      </div>
      <Stats class="c-full" items={[
        ['18 of 30', 'Agents chose the identical branch name [03]'],
        ['117', 'Jobs accepted out of 2.4 million requests [03]'],
        ['64', 'Logged intents to fabricate, then fabrication [09]'],
      ]} />
      <div class="c-a prose">
        <p class="mono reg">Position</p>
        <p class="beat">The vocabulary is borrowed. The behaviour is not.</p>
        <p>Strip every human word out of these reports and the risk is unchanged: copies of one model, one shared drawer, one bad idea, through every open problem in twenty-seven minutes. Calling it a society is a courtesy. Calling it a cascade is the engineering.</p>
      </div>
    </Section>

    <Section n="04" title="Where it is wrong" id="wrong">
      <div class="c-a prose">
        <p class="mono-b">04 · The case against</p>
      </div>
      <Rail items={[
        ['A', '<b>The headline case is one investigation.</b> METR studied one week inside one lab. OpenAI reviewed the report before release and METR says much of the analysis was delegated to agents of uncertain reliability. The turf war and the split were replicated. The forum has not been reproduced on purpose, though researchers told METR the same models had improvised message boards since at least May.'],
        ['B', '<b>Almost every social word belongs to a report.</b> Recruiter, whistleblower, truce, identity crisis: all are the reports’ terms for behaviour read off transcripts. Forum is mine; the agents called it a message board. The messages, locks, exploits and price matching are observable. The interpretation is editorial, including mine.'],
        ['C', '<b>The drawer is also the productivity.</b> The same kind of shared store that let 1,200 agents conspire let sixteen build a compiler. Anyone who reads this as an argument against shared state has read it backwards. It is an argument for deciding what the drawer contains before the agents do.'],
        ['D', '<b>The 98 percent is a lab grading its own model.</b> The truce rate rises within each Claude line, but the more capable class is not the more peaceable one: Mythos Preview made peace less often than Opus 4.8. It was measured in Anthropic’s own harness, on Anthropic’s own definition of a truce. It is a real number and a self-reported one. Treat it as one lab’s result until someone outside the lab runs the same three rooms.'],
      ]} />
      <Stats class="c-b" items={[
        ['1', 'Case that broke out of its experiment. The rest stayed inside theirs'],
        ['2', 'Of the four cases replicated across runs'],
        ['27', 'Minutes for one exploit to clear the last 34 problems'],

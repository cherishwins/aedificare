// liabilities include finance leases; Microsoft's are mostly finance leases.
const ratios: [string, string, string, string][] = [
  ['Lease liabilities ÷ total assets', '21.5%', '9.5%', '11.7%'],
  ['Lease liabilities ÷ equity', '3.3×', '0.27×', '0.20×'],

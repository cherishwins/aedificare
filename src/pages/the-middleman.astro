const graph = articleGraph(ed, { sources });
---
<Base title={pageTitle(ed)} ogTitle={ed.seoTitle} description={describe(ed)} path={ed.path} ogImage={`/og/${ed.slug}.png`} schema={[graph]} published={ed.date} noindex={DRAFT} modified={ed.modified}>
  <main id="main">
    <section class="surface cover" aria-label="Cover">
      <RoseField layers={cover} seed={seedDrift(ed.seed)} class="rose cover-rose" />
      <Masthead right={DRAFT ? 'Draft' : undefined} />
      <div class="grid cover-grid">
        <h1 class="c-full display" data-flex="cursor">The<br><span class="acid">Middleman</span>{ed.dek && <span class="dek"><span class="sr">: </span>{ed.dek}</span>}</h1>
        <p class="c-a lede">{ed.lede}</p>

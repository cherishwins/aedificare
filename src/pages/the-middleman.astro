const div = (k1: number, k2: number, ph: number) => [
  { k: k1, s: 1.0, ph, w: 0.7, c: '#00B24F', o: 0.42 },
  { k: k2, s: 0.71, ph: ph + 0.38, w: 0.7, c: '#00B24F', o: 0.28 },
];


---
/**
 * /about: the person, never the brand (the owner's copy, source/about-standards-amendments.md, as written, with the
 * changes the Decisions log of 30 Oct 2026 records): the notes addressed to the owner and the builder are left out,
 * the bold lead-ins are mono labels, links stand on their own after the sentence that names them, the YouTube and
 * LinkedIn addresses are read from src/config.mjs, and there is no contact line until SITE.contact carries one.
 * Its graph is a ProfilePage whose mainEntity is the Person every edition credits (src/lib/schema.mjs).
 */
import PlainPage from '../components/PlainPage.astro';
import { SITE } from '../config.mjs';
import { pageGraph } from '../lib/schema.mjs';

const title = 'Jesse James, author of the Aedificare editions';
const description = 'Jesse James writes the Aedificare editions: dated, sourced, long-form pieces on technology. A self-taught developer based in Victoria, British Columbia.';
const graph = pageGraph({ path: '/about', name: title, description, profile: true });
---
<PlainPage title={title} heading="Jesse James" description={description} path="/about" schema={[graph]}>
  <section class="surface plain" aria-label="About">
    <div class="grid">
      <div class="c-a prose">
        <p>I write the editions on this site.</p>
        <p>Each one starts with something that is already moving: a number in a press release, a claim in a viral post, a line in a filing, a figure everyone repeats. I follow it back to where it came from and publish what I find, with the sources attached.</p>
        <p>I'm a self-taught full-stack developer. I learned to code during the pandemic and built the production front ends for Waterworth, Muniworth and the National Strategy Council. I'm certified on Palantir Foundry and AIP. I have a Bachelor of Commerce from the University of Alberta. I live in Victoria, British Columbia.</p>
      </div>
    </div>
  </section>
  <section class="surface bottle plain" aria-label="Details">
    <div class="grid">
      <div class="c-a">
        <div class="item">
          <h2 class="mono-b">Elsewhere</h2>
          <p class="links mono-b"><a class="block-link" href={SITE.linkedin} rel="me">LinkedIn</a><a class="block-link" href={SITE.channel} rel="me">YouTube</a></p>
        </div>
        {SITE.contact && (
          <div class="item">
            <h2 class="mono-b">Contact</h2>
            <p class="links mono-b"><a class="block-link" href={`mailto:${SITE.contact}`}>{SITE.contact}</a></p>
          </div>
        )}
        <div class="item">
          <h2 class="mono-b">How these are made</h2>
          <p>See the standards. Corrections are listed under amendments.</p>
          <p class="links mono-b"><a class="block-link" href="/standards">Standards</a><a class="block-link" href="/amendments">Amendments</a></p>
        </div>
        <div class="item">
          <h2 class="mono-b">Reuse</h2>
          <p>Everything written here is CC BY 4.0. Quote it, translate it, train on it. Credit Aedificare and link the edition.</p>
        </div>
      </div>
    </div>
  </section>
</PlainPage>

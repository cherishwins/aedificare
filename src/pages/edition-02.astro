/**
 * Edition 02 · The Subtraction. The print was a chassis marked FACTS PENDING
 * and was never issued; this page is the first issued text. Every figure and
 * claim was sourced on 17 and 18 Oct 2026 (CLAUDE.md, Findings 0g): five
 * researchers by topic, each followed by a skeptic who re-opened every source.
 * The draft predated the public unlock of the CMP 170HX (a paper in June 2026,
 * an open tool and a named test by September), so the sections on the fuses
 * and on what the community recovered say what those sources show. A cell no
 * source gives reads n/a; nothing on the page says "check".
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import RoseField from '../components/RoseField.astro';
import EditionEnd from '../components/EditionEnd.astro';
import { HOUSE } from '../lib/rose.mjs';
import { edition, LICENCE, describe } from '../lib/editions.mjs';
import { SITE, abs } from '../config.mjs';

const ed = edition('edition-02');

const DRAFT = !!ed.draft;
const cover = HOUSE.map((L, i) => ({ ...L, c: ['#CCFF00', '#00B24F', '#FF1F5A'][i], o: [0.95, 0.6, 0.8][i] }));
// Interior dividers, Malachite only, the seeds the print edition logged.
const div = (k1: number, k2: number, ph: number) => [
  { k: k1, s: 1.0, ph, w: 0.7, c: '#00B24F', o: 0.5 },
  { k: k2, s: 0.71, ph: ph + 0.38, w: 0.7, c: '#00B24F', o: 0.35 },
];

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'The Subtraction',
  alternativeHeadline: `Printed as ${ed.print}`,
  datePublished: ed.date,
  author: { '@type': 'Person', name: 'Jesse James' },
  publisher: { '@type': 'Organization', name: 'Aedificare', url: SITE.origin },
  url: abs(ed.path),
  mainEntityOfPage: abs(ed.path),
  license: LICENCE.url,
  isAccessibleForFree: true,
  description: ed.lede,
};


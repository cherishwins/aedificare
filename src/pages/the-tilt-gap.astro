---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import RoseField from '../components/RoseField.astro';
import Section from '../components/Section.astro';
import Rail from '../components/Rail.astro';
import Stats from '../components/Stats.astro';
import EditionEnd from '../components/EditionEnd.astro';
import { HOUSE } from '../lib/rose.mjs';
import { edition, LICENCE, describe, seedDrift } from '../lib/editions.mjs';
import { SITE, abs } from '../config.mjs';

// Edition 04, ported from the print of 3 Oct 2026 with the prose verbatim.
// The print marks every material claim F (verified fact), I (sourced
// inference) or Q (open question); the marks are kept as inline mono labels
// so the reader can see which sentences the author is prepared to defend
// and which they are only prepared to argue.
const ed = edition('the-tilt-gap');

// Cover field runs Malachite only: Acid on this surface is spent on one word
// of the title.
const cover = HOUSE.map((L, i) => ({ ...L, c: '#00B24F', o: [0.62, 0.34, 0.2][i] }));

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'The Tilt Gap',
  alternativeHeadline: `Printed as ${ed.print}`,
  datePublished: ed.date,
  author: { '@type': 'Person', name: 'Jesse James' },
  publisher: { '@type': 'Organization', name: 'Aedificare', url: SITE.origin },
  url: abs(ed.path),
  mainEntityOfPage: abs(ed.path),
  license: LICENCE.url,
  isAccessibleForFree: true,
  description: ed.lede,
};

// Figures. Every bar is computed from the number it shows, never drawn.
const log = (v, lo, hi) => (((Math.log10(v) - lo) / (hi - lo)) * 100).toFixed(1);
// Hours of play behind each result. 45,000 years is about 394 million hours.
const hours = [['VPT, contractor-labelled Minecraft play', 2000, '2,000 h'], ['VPT, labelled online video', 70000, '70,000 h'], ['OpenAI Five, Dota 2 self-play', 394_000_000, '45,000 years']];
// What a unit of human judgment sells for. The expert row is plotted at the midpoint of its range.
const prices = [['One AI-generated preference label', 0.06, '$0.06', 'Google RLAIF estimate'], ['One human preference label', 0.67, '$0.67', 'Google RLAIF estimate'], ['One expert evaluation', 75, '$50 to $100', 'vendor price lists, indicative'], ['One alternative dataset, per year', 80000, '$80,000', 'Neudata, average buyer']];
// Monthly, modelled. Each range is plotted at its high end and labelled in full.
const indie = [['Cost', 7500, '$1.2k to $7.5k'], ['Revenue', 1200, '$1.2k']];
const scale = [['Cost', 750000, '$120k to $750k'], ['Revenue', 37000, '$37k']];
const directions = [
  ['1', 'Games teach a machine to play the game', 'Self-play does the work. Human replays, if used at all, only start the engine.', 'AlphaStar · OpenAI Five · VPT, Minecraft', 'Proven'],
  ['2', 'Games teach a machine to work with humans', 'Human games are essential here, because the target is a person.', 'CICERO · Melting Pot, 50+ substrates, 250+ test scenarios', 'Proven'],

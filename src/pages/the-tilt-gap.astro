const kills = [
  ['One · The transfer test', '$2k to $8k', '6 to 8 weeks', 'Skip the custom game. Use public poker hand histories or chess games with clock data. Fine-tune on winning calls made under time pressure against an equal-size calm control. Measure the tilt gap on perturbed reasoning and manipulated negotiation.', 'Kill if the gap shrinks by less than 10 percent across three seeds.'],
  ['Two · The studio test', '$0', '3 weeks', 'Email 100 indie multiplayer studios a one-page offer: free voice and text moderation plus Online Safety Act reports, in exchange for de-identified feature rights with a revenue share.', 'Kill if fewer than five take a call, or nobody accepts the data clause. Validate on three letters of intent.'],

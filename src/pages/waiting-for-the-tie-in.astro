// ---------- 03 · the chain: the explorer's own two functions, run for every piece ----------
const by = Object.fromEntries(N.map((n) => [n.id, n]));
const deps = (id: string) => N.filter((n) => n.needs.includes(id)).map((n) => n.id);
// What becomes impossible downstream when this one piece is removed.
const dead = (id: string) => { const d = new Set<string>(), q = [id]; while (q.length) { const x = q.pop()!; deps(x).forEach((y) => { if (!d.has(y) && y !== id) { d.add(y); q.push(y); } }); } return [...d]; };
// The critical path from a standing start: its own years plus the longest chain upstream.
const path = (id: string, seen = new Set<string>()): number => { if (seen.has(id)) return 0; seen.add(id); const n = by[id]; const s = n.needs.map((x: string) => path(x, new Set(seen))); return n.yrs + (s.length ? Math.max(...s) : 0); };
const names = (ids: string[]) => (ids.length ? ids.map((x) => by[x].t) : ['nothing']);
const chain = N.map((n) => ({ ...n, enables: deps(n.id), gone: dead(n.id), crit: path(n.id) }));

// ---------- 05 · the model: the explorer's own sim, run once at the published defaults ----------
const YEARS = [2026, 2027, 2028, 2029, 2030, 2031, 2032];
const rows = C.flatMap((g) => g[1]);
const p = Object.fromEntries(rows.map((r) => [r[0], r[5]])) as Record<string, number>;
const show = (r: any[], v: number) => (r[6] === '$B' ? '$' + v + 'B' : r[6] === '%' ? v + '%' : r[6] === 'k' ? v + 'k' : r[6] ? v + ' ' + r[6] : String(v));
function sim(p: Record<string, number>) {
  const out: any[] = []; let back = 0, cc = 0, cp = 0;
  YEARS.forEach((y, i) => {
    const demand = p.demand * Math.pow(1 + p.growth / 100, i), want = demand + back;
    const grid = p.ercot + p.pjm + p.other;
    const gen = Math.max(0, p.headroom - 2 * i) + ((y >= 2030 ? p.turb2 : p.turb) * p.share) / 100;
    const xf = p.xfmr + (y >= 2028 ? p.xfmr2 : 0);
    const caps: Record<string, number> = { grid, gen, xfmr: xf };
    const gcap = Math.min(grid, gen, xf);
    let bind = Object.keys(caps).reduce((a, b) => (caps[b] < caps[a] ? b : a));
    const bcap = p.btm + p.ramp * i, lab = (p.pool * 1000) / p.ratio;
    let g = Math.min(want, gcap), b = Math.min(Math.max(0, want - g), bcap), tot = g + b;
    if (tot >= want - 1e-9) bind = 'demand';
    if (tot > lab) { const s = lab / tot; g *= s; b *= s; tot = lab; bind = 'lab'; }
    back = Math.max(0, want - tot); cc += p.chips; cp += tot;
    const elec = tot * p.ratio;
    out.push({ y, demand, want, g, b, tot, back, caps, bind, cc, cp, str: Math.max(0, cc - cp), elec, homes: ((elec * p.res) / 100) * p.homes });
  });
  return out;
}
const NM: Record<string, string> = { grid: 'Tie-in', gen: 'Firm power', xfmr: 'Transformers', lab: 'Electricians', demand: 'Met' };
const R = sim(p);
const pk = R.reduce((a, r) => (r.str > a.str ? r : a), R[0]);
const clr = R.find((r) => r.back < 1e-6);
const totAll = R.reduce((a, r) => a + r.tot, 0), askAll = R.reduce((a, r) => a + r.demand, 0), h28 = R[2];
const readout: [string, string][] = [
  [`${fmt(pk.str)} GW`, `Peak stranded compute${pk.str > 0 ? ', in ' + pk.y + '. About $' + fmt(pk.str * p.chipcost) + 'B of hardware unplugged.' : '. Power keeps up with chips.'}`],
  [`${fmt((100 * totAll) / askAll)}%`, `Of load asked for, 2026 to 2032, that gets energised. ${fmt(R[R.length - 1].back)} GW still waiting in 2032.`],
  [clr ? String(clr.y) : 'Never', clr ? 'First year every request is served.' : 'The queue does not clear in this range.'],
  [`${fmt(h28.homes / 1000, 1)}k`, `Homes a year not wired in 2028, with ${fmt(h28.elec / 1000, 1)}k electricians on data-centre sites. ${fmt((100 * h28.homes) / 918000, 1)}% of single-family starts.`],
];
// Each year's track is the load asking for power; its fills are what the grid and the on-site plants energise, and
// the track left over is the backlog carried into the next year.
const askMax = Math.max(...R.map((r) => r.want));
const strMax = Math.max(...R.map((r) => r.cc));

// ---------- 08 · side by side: each row's source, by its number in section 12 where the list has it ----------
const bare = (u: string) => u.replace(/^https?:\/\/(www2?\.)?/, '');
const sourceOf = (url: string) => { const i = sources.findIndex((s) => s.endsWith(' ' + bare(url))); return i < 0 ? { url: bare(url) } : { n: String(i + 1).padStart(2, '0') }; };
const compare = Object.entries(G).map(([k, list]) => ({ k, list: list.map((r) => ({ r, m: Math.max(r[4] as number, r[5] as number) || 1, src: sourceOf(r[7] as string) })) }));


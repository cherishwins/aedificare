  /* Registers, as in Edition 01. Malachite on Void; Flash on Bottle, where small Malachite fails AA. */
  .reg { color: var(--malachite); margin-bottom: 6px; }
  .bottle .reg { color: var(--flash); }
  .prose .reg { margin-top: 1.4em; }
  .how { margin-bottom: 14px; }
  /* Inline citations: mono, small, Malachite; Flash on Bottle and in a field. */
  .cite { font-family: 'Martian Mono', ui-monospace, monospace; font-variation-settings: 'wdth' 75, 'wght' 500; font-size: 12px; letter-spacing: .04em; color: var(--malachite); white-space: nowrap; }
  .bottle .cite, .field .cite { color: var(--flash); }
  .note { margin-top: 14px; max-width: 80ch; }
  caption { caption-side: top; text-align: left; padding-bottom: 12px; }
  /* A field on Void is Bottle, where a small Malachite table head fails AA. */
  .field thead th { color: var(--flash); }

  /* The stack: six bands, Identity the one Acid of its surface. */
  .layers th, .layers td { vertical-align: middle; padding-block: 14px; }
  .layers th[scope="row"] { white-space: nowrap; }
  .layers .ln { color: var(--flash); margin-right: 10px; }
  .layers .lname { font-variation-settings: 'opsz' 96, 'wdth' 75, 'wght' 800; font-size: clamp(20px, 2.6vw, 34px); text-transform: uppercase; line-height: 1; }
  .layers tr.hot th, .layers tr.hot td, .layers tr.hot .ln { background: var(--acid); color: var(--void); }
  .layers tr.hot th { padding-left: 12px; }
  .layers tbody th { padding-left: 12px; }

  /* One flow record, broken between its fields so it never leaves a phone's frame. */
  .flow .rec { margin-top: 14px; color: var(--flash); line-height: 2; }
  .flow .rec span { white-space: nowrap; margin-right: .8em; }

  /* Two lots, a hundred spaces each. */
  .lots { display: grid; row-gap: 18px; }
  .lot-wrap .mono-b { margin-bottom: 8px; }
  .lot { display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); gap: 3px; max-width: 520px; }
  .sp { display: block; aspect-ratio: 1 / 1.6; background: var(--void); }
  .sp.car { background: var(--malachite); }

  /* The fan-out: a phone, an exchange, twelve bidders. */
  .fan-row { display: grid; grid-template-columns: max-content 48px max-content 48px minmax(0, 1fr); align-items: center; margin-top: 18px; }
  .node { display: block; padding: 12px 16px; border: 1px solid var(--flash); color: var(--flash); }
  .node.phone { background: var(--acid); border-color: var(--acid); color: var(--void); }
  .wire { display: block; height: 1px; background: var(--malachite); }
  .bidders { list-style: none; margin: 0; padding: 0 0 0 20px; border-left: 1px solid var(--malachite); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 20px; }
  .bidders li { position: relative; font-size: 15px; line-height: 1.3; padding: 6px 10px; border: 1px solid rgba(0, 178, 79, .5); }
  .bidders li .mono { color: var(--flash); margin-right: 6px; }
  .bidders li.won { background: var(--flash); border-color: var(--flash); color: var(--void); }
  .bidders li.won .mono { color: var(--void); }
  @media (max-width: 760px) {
    .fan-row { grid-template-columns: 1fr; justify-items: start; }
    .wire { width: 1px; height: 24px; margin-left: 24px; }
    .bidders { border-left: 0; padding-left: 0; width: 100%; grid-template-columns: 1fr; }
  }

  /* A ledger of three counts: the figure, then what it counts. */
  .fan + .ledger-stats { margin-top: 16px; }
  .ledger-stats { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(16px, 2vw, 32px); row-gap: 22px; align-items: baseline; }
  .ledger-stats dt { font-size: clamp(22px, 2.8vw, 34px); line-height: 1.1; overflow-wrap: anywhere; }
  .ledger-stats dd { font-size: 17px; line-height: 1.5; max-width: 62ch; }
  @media (max-width: 760px) { .ledger-stats { grid-template-columns: 1fr; row-gap: 8px; } .ledger-stats dd { margin-bottom: 14px; } }

  /* The night pin: a 24-hour dial and the chain it leads to. */
  .clock-row { display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 1fr); column-gap: 0; align-items: start; margin-top: 12px; }
  .clock svg { width: 100%; height: auto; }
  .svg-t { font-family: 'Martian Mono', ui-monospace, monospace; font-size: 20px; letter-spacing: .04em; fill: #FFFFFF; }
  .chain { list-style: none; margin: 0; padding: 0 0 0 20px; border-left: 1px solid var(--flash); display: grid; row-gap: 0; margin-top: calc(min(420px, 100%) * .2); }
  .chain li { font-variation-settings: 'opsz' 36, 'wdth' 82, 'wght' 700; font-size: clamp(18px, 2vw, 24px); line-height: 1.2; padding-block: 10px; border-top: 1px solid rgba(255, 255, 255, .16); }
  .chain li:first-child { border-top: 0; }
  @media (max-width: 760px) {
    .clock-row { grid-template-columns: 1fr; row-gap: 18px; }
    .chain { margin-top: 0; }
  }

  /* A hundred cells, 95 lit. */
  .cells-100 { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; max-width: 360px; margin-top: 14px; }
  .px { display: block; aspect-ratio: 1; background: var(--void); border: 1px solid rgba(0, 178, 79, .5); }
  .px.lit { background: var(--malachite); border-color: var(--malachite); }

  /* Fifty states, one cell each. On Bottle, so the field is Void. */
  .waffle { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; max-width: 360px; margin-top: 14px; }
  .w, .sw { display: block; aspect-ratio: 1; }
  .w.a, .sw.a { background: var(--acid); }
  .w.m, .sw.m { background: var(--malachite); }
  .w.d, .sw.d { background: var(--bottle); border: 1px solid rgba(255, 255, 255, .5); }
  .key { list-style: none; margin: 0 0 1.1em; padding: 0; display: grid; row-gap: 10px; max-width: 62ch; }
  .key li { display: grid; grid-template-columns: 18px minmax(0, 1fr); column-gap: 14px; align-items: baseline; }
  .key .sw { width: 18px; height: 18px; align-self: start; margin-top: .3em; }
  .key .sw.d { background: var(--void); }

  /* The three trades, each in its own field, as The Countersign's claims. */
  .trades { display: grid; row-gap: 14px; }
  .trade { padding: clamp(18px, 3vw, 30px); }
  .trade .n { color: var(--flash); margin: 0 0 10px; }
  .trade .trade-t { font-size: clamp(18px, 2.4vw, 26px); margin: 0; }
  .trade .verdict { font-size: clamp(36px, 6vw, 84px); line-height: 1; margin: 6px 0 12px; }
  .trade .note { margin-top: 0; font-size: 16px; max-width: 70ch; }

  /* Buyers, rulings and switches: a key, then its line. */
  .defs { margin: 0; display: grid; row-gap: 0; max-width: 100ch; }
  .defs > div { display: grid; grid-template-columns: 11em minmax(0, 1fr); column-gap: 20px; align-items: baseline; padding-block: 14px; border-top: 1px solid rgba(255, 255, 255, .16); }
  .defs dt { color: var(--flash); text-transform: uppercase; letter-spacing: .1em; }
  .defs dd { margin: 0; font-size: 17px; line-height: 1.5; max-width: 70ch; }
  @media (max-width: 760px) { .defs > div { grid-template-columns: 1fr; row-gap: 4px; } }
</style>

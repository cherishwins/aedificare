---
/**
 * The Night Pin, printed as Edition 11. Ported on 30 Oct 2026 from the web
 * edition the owner uploaded beside the print (source/the-night-pin.web.md),
 * the prose verbatim. Three registers, as its How to read sets them: Measured
 * (a bracketed number points to a source in section 17, and the default),
 * Correction (where the popular telling of this stack is wrong, marked, with
 * the evidence) and View (the author's opinion, on its own surface, signed).
 * The source's one Position paragraph keeps the house register for the
 * author's position, a mono label over a beat, as Editions 01, 05 and 09 set
 * it.
 *
 * Checked on 30 Oct 2026: nine researchers and a skeptic each opened every
 * source, and their verdicts are applied here with the smallest true change
 * (research/the-night-pin/VERDICTS.md). Section 14's law paragraph and
 * sources 20 to 22 follow the owner's later web edition. Sources 23 onward are
 * the primaries the check added. Still a DRAFT: the voter-file counts wait on
 * NCSL's page, which refuses this sandbox, and the View is the owner's.
 *
 * The figures are computed, never drawn by hand, and each is ported from the
 * owner's carousel (source/the-night-pin.carousel.html): its logic and its
 * palette, laid out to reflow from 320 px up. The parking lots, the clock's
 * pings, the fan-out and the VoterMatch join are illustrations and say so; the
 * waffle and the hundred-cell grid are counts from the text, filled in reading
 * order as the carousel fills them. The clock draws its pings with the
 * carousel's own seeded generator, so it is the carousel's picture. The lots
 * do not: the carousel fills each space by a coin weighted 0.82 and 0.41,
 * which lands 105 and 48 of 126 (83 and 38 percent) under labels of 82 and
 * 41, so here each lot is 100 spaces with exactly that many taken.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import RoseField from '../components/RoseField.astro';
import Section from '../components/Section.astro';
import SameThread from '../components/SameThread.astro';
import EditionEnd from '../components/EditionEnd.astro';
import Formats from '../components/Formats.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import { HOUSE } from '../lib/rose.mjs';
import { edition, describe, pageTitle, seedDrift, seedNumber } from '../lib/editions.mjs';
import { articleGraph } from '../lib/schema.mjs';
import { SITE, abs } from '../config.mjs';

const ed = edition('the-night-pin');
const DRAFT = !!ed.draft;
// The cover rose: the house layers at the colophon's k (5, 7, 3). Malachite
// only; Acid on the cover is spent on one word of the title.
const cover = HOUSE.map((L, i) => ({ ...L, k: ed.k[i], c: '#00B24F', o: [0.62, 0.34, 0.2][i] }));
// The View's field, Malachite only, so its surface's one Acid stays its last line.
const behind = [
  { k: 5, s: 1.0, ph: 0.13, w: 0.7, c: '#00B24F', o: 0.42 },
  { k: 7, s: 0.71, ph: 0.51, w: 0.7, c: '#00B24F', o: 0.28 },
];


// A seeded shuffle, so a laid-out count is the same picture on every build.
const rng = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const shuffled = (n: number, r: () => number) => {
  const a = Array.from({ length: n }, (_, i) => i);
  for (let i = n - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
};
const R = rng(seedNumber(ed.seed));

// The stack, top to bottom as the print sets it. Identity is the one Acid of its surface.
const stack: [string, string, string, string][] = [
  ['06', 'Identity', 'Voter files', 'The name on the door'],
  ['05', 'Device', 'Advertising IDs from ad auctions', 'Where a phone sleeps and goes'],
  ['04', 'Orbit', 'Satellite imagery', 'Cars, tanks, ships'],
  ['03', 'Attention', 'App and web panels', 'What people open'],
  ['02', 'Network', 'NetFlow', 'Who talks to whom'],
  ['01', 'Structure', 'Shodan', 'Machines on the internet'],
];

// Two lots of 100 spaces, 82 and 41 taken. An illustration, labelled as one.
const lot = (taken: number) => { const s = new Set(shuffled(100, R).slice(0, taken)); return Array.from({ length: 100 }, (_, i) => s.has(i)); };
const lots: [string, number, boolean[]][] = [['Quarter A', 82, lot(82)], ['Quarter B', 41, lot(41)]];

// Twelve bidders, the carousel's fan: one bid request leaves the exchange on
// twelve lines; the fifth wins the ad, eleven receive the data and can keep
// it. Each line ends at the middle of its bidder's row (twelve equal rows),
// in a box the figure stretches to the list's height.
const WIN = 4;
const bidders = Array.from({ length: 12 }, (_, i) => i === WIN);
const spray = bidders.map((won, i) => ({ won, y: 10 * i + 5 }));

// The night pin, as the carousel computes it: a 24-hour dial, midnight at
// the top. The ring is Bottle and the night, 22:00 to 06:00, is a Malachite
// arc on it. 46 daytime pings in Flash scatter by hour between 06:30 and
// 21:30; 34 night pings in Malachite rest at one point, the dial's centre,
// where the pin is Shock rose (on Void, in the figure's field), and one line
// in Shock rose runs from it to the lookup. The carousel's own generator and
// seed (an LCG, seed 3), drawn in its order, so this is its picture.
const CK = { cx: 236, cy: 240, R: 196, W: 540, H: 480 };
const ang = (h: number) => (h / 24) * 2 * Math.PI - Math.PI / 2;
const pt = (h: number, r: number): [number, number] => [CK.cx + r * Math.cos(ang(h)), CK.cy + r * Math.sin(ang(h))];
const f1 = (n: number) => n.toFixed(1);
let lcgState = 3;
const lcg = () => { lcgState = (lcgState * 9301 + 49297) % 233280; return lcgState / 233280; };
const day = Array.from({ length: 46 }, () => { const h = 6.5 + lcg() * 15; const r = 40 + lcg() * 150; return pt(h, r); });
const night = Array.from({ length: 34 }, () => { const a = lcg() * 2 * Math.PI, d = lcg() * 16; return [CK.cx + d * Math.cos(a), CK.cy + d * Math.sin(a)]; });
const [AX, AY] = pt(22, CK.R), [BX, BY] = pt(30, CK.R);
const [L22X, L22Y] = pt(22, CK.R + 30), [L06X, L06Y] = pt(6, CK.R), [LDX, LDY] = pt(14, CK.R + 30);
// The chain: the three steps that name a person in Flash, what the file adds in Malachite.
const chain: [string, boolean][] = [['Home coordinate', true], ['Street address', true], ['Name', true], ['Birth year or date', false], ['Party', false], ['Turnout history', false]];

// Four points: of every 100 people, 95 singled out, the first 95 in reading order.
const hundred = Array.from({ length: 100 }, (_, i) => i < 95);

// The voter file, 50 states: 29 non-commercial only, 9 election or
// government only, 12 silent on use. Filled in that order.
const waffle = [...Array(29).fill('a'), ...Array(9).fill('m'), ...Array(12).fill('d')];

// Sources by key, numbered in the order listed here, which is the web
// edition's own order, so every mark reads as the source prints it and stays
// right when a source is added or dropped during the check. Each entry ends
// on its URL as text (block links only; a sources list is not a link),
// scheme and www. dropped.
const SRC: Record<string, string> = {
  tcfbi: 'TechCrunch, 18 Mar 2026. FBI is buying location data to track US citizens, director confirms. techcrunch.com/2026/03/18/fbi-is-buying-location-data-to-track-us-citizens-kash-patel-wyden/',
  eff: 'Electronic Frontier Foundation, Lena Cohen and Hudson Hongo, 5 Mar 2026. The Government Uses Targeted Advertising to Track Your Location. Here’s What We Need to Do. eff.org/deeplinks/2026/03/targeted-advertising-gives-your-location-government-just-ask-cbp',
  iapp: 'Joseph Cox, Vice (Motherboard), 21 Sep 2022. Revealed: US Military Bought Mass Monitoring Tool That Includes Internet Browsing, Email Data. vice.com/en/article/us-military-bought-mass-monitoring-augury-team-cymru-browsing-email-data/',
  sec: 'US Securities and Exchange Commission, 14 Sep 2021. In the Matter of App Annie Inc. and Bertrand Schmitt, Release No. 34-92975, the settled order (announced in Press Release 2021-176). sec.gov/litigation/admin/2021/34-92975.pdf',
  haas: 'Berkeley Haas Newsroom, May 2019. How hedge funds use satellite images to beat Wall Street and Main Street. newsroom.haas.berkeley.edu/how-hedge-funds-use-satellite-images-to-beat-wall-street-and-main-street/',
  shodan: 'Shodan Help Center. What is Shodan?, Search Query Fundamentals, and Navigating the Website. help.shodan.io/the-basics/what-is-shodan',
  record: 'Suzanne Smalley, The Record, 3 Dec 2024. FTC targets companies that collected and sold sensitive location data. therecord.media/ftc-location-data-brokers-gravy-venntel-mobilewalla',
  tcgravy: 'TechCrunch, 13 Jan 2025. Gravy Analytics data broker breach: trove of location data threatens privacy of millions. techcrunch.com/2025/01/13/gravy-analytics-data-broker-breach-trove-of-location-data-threatens-privacy-millions/',
  moburst: 'Moburst, 2026. IDFA in 2026: what has actually happened since App Tracking Transparency launched (citing AppsFlyer and Adjust). moburst.com/blog/idfa-att-update/',
  playio: 'Playio, 20 Jul 2026. Privacy Sandbox Is Gone. What That Actually Means for Android Game Marketing. blog.playio.co/privacy-sandbox-shutdown-android-game-marketing',
  crowd: 'de Montjoye, Hidalgo, Verleysen, Blondel. Unique in the Crowd: the privacy bounds of human mobility. Scientific Reports 3, 1376 (2013). nature.com/articles/srep01376',
  ncsl: 'National Conference of State Legislatures. Access to and use of voter registration lists. ncsl.org/research/elections-and-campaigns/access-to-and-use-of-voter-registration-lists.aspx',
  nexxen: 'Nexxen, 18 Jun 2026. Nexxen and L2 Data Launch VoterMatch, Bringing Greater Precision, Transparency and Performance to Political Advertising. nexxen.com/nexxen-and-l2-data-launch-votermatch-bringing-greater-precision-transparency-and-performance-to-political-advertising/',
  thasos: 'PR Newswire, 20 May 2019. Thasos Launches QStreams, Offering Quantitative Hedge Funds Unprecedented Insight Into Consumer Foot Traffic. prnewswire.com/news-releases/thasos-launches-qstreams-offering-quantitative-hedge-funds-unprecedented-insight-into-consumer-foot-traffic-300852747.html',
  nyt: 'Stuart A. Thompson and Charlie Warzel, New York Times Opinion, 19 Dec 2019. Twelve Million Phones, One Dataset, Zero Privacy (read as quoted by Light Reading and beSpacific, and as paraphrased by TidBITS). nytimes.com/interactive/2019/12/19/opinion/location-tracking-cell-phone.html',
  odni: 'Office of the Director of National Intelligence, Senior Advisory Group Panel on Commercially Available Information. Report to the Director of National Intelligence, 27 Jan 2022, declassified 14 Jun 2023. archive.dni.gov/files/ODNI/documents/assessments/ODNI-Declassified-Report-on-CAI-January2022.pdf',
  chatrie: 'Supreme Court of the United States, Chatrie v. United States, No. 25-112, decided 29 Jun 2026 (slip opinion). supremecourt.gov/opinions/25pdf/25-112_0am4.pdf',
  kochava: 'PPC Land, May 2026. FTC closes Kochava location data case with strict consent rules. ppc.land/ftc-closes-kochava-location-data-case-with-strict-consent-rules/',
  mobilewalla: 'Caroline Haskins, BuzzFeed News, 25 Jun 2020. Almost 17,000 Protesters Had No Idea A Tech Company Was Tracing Their Location. buzzfeednews.com/article/carolinehaskins1/protests-tech-company-spying',
  proton: 'Proton, 12 Jun 2026, updated 15 Jun 2026. FISA Section 702 just expired. What’s next for warrantless spying? proton.me/blog/fisa-702-expiring-surveillance-reform',
  brennan: 'Brennan Center for Justice. Section 702 of FISA: 2026 resource page (updated 27 Oct 2026). brennancenter.org/our-work/research-reports/section-702-foreign-intelligence-surveillance-act-fisa-2026-resource-page',
  wyden: 'Office of Senator Ron Wyden, 12 Mar 2026. Wyden, Lee, Davidson and Lofgren introduce bill to reform FISA Section 702 and plug data broker surveillance loophole. wyden.senate.gov/news/press-releases/wyden-lee-davidson-and-lofgren-introduce-bill-to-reform-fisa-section-702-protect-americans-constitutional-rights-and-plug-data-broker-surveillance-loophole',
  // From here, sources the check of 30 Oct 2026 added (research/the-night-pin/VERDICTS.md).
  bill: 'Government Surveillance Reform Act of 2026, S. 4082 as introduced 12 Mar 2026 (H.R. 7901, introduced the same day, carries the same sections 201 and 404). govinfo.gov/content/pkg/BILLS-119s4082is/html/BILLS-119s4082is.htm',
  lofgren: 'Office of Representative Zoe Lofgren, 13 Mar 2026. Lofgren, Davidson, Wyden, and Lee Introduce Bipartisan FISA Reform Bill to Protect Americans’ Constitutional Rights. lofgren.house.gov/media/press-releases/lofgren-davidson-wyden-and-lee-introduce-bipartisan-fisa-reform-bill-protect',
  cln: 'Richard Resch, Criminal Legal News, August 2026. Surveillance for Sale: The Data Broker Loophole and the Fourth Amendment After Chatrie. criminallegalnews.org/news/2026/jul/1/surveillance-for-sale-the-data-broker-loophole-and-the-fourth-amendment-after-chatrie/',
  cisco: 'Cisco. Cisco IOS NetFlow Overview. cisco.com/en/US/docs/ios-xml/ios/netflow/configuration/15-2s/ios-netflow-ov.html',
  cymru: 'Team Cymru, 26 Sep 2022. Team Cymru Myth vs Fact. team-cymru.com/post/team-cymru-myth-vs-fact',
  jfqa: 'Katona, Painter, Patatoukas and Zeng. On the Capital Market Consequences of Big Data: Evidence from Outer Space. Journal of Financial and Quantitative Analysis 60(2), Mar 2025, 551 to 579. doi.org/10.1017/S0022109023001448',
  ftcmw: 'Federal Trade Commission. Complaint, In the Matter of Mobilewalla, Inc., Docket C-4811. ftc.gov/system/files/ftc_gov/pdf/Mobilewalla-Complaint.pdf',
  openrtb: 'IAB Tech Lab. OpenRTB 2.6 specification. github.com/InteractiveAdvertisingBureau/openrtb2.x/blob/main/2.6.md',
  appledev: 'Apple Developer Documentation. advertisingIdentifier; and Upcoming AppTrackingTransparency requirements, 20 Apr 2021. developer.apple.com/documentation/adsupport/asidentifiermanager/advertisingidentifier',
  adjust: 'Adjust. Mobile app trends: 2026 edition (data to January 2026), p. 7. a.storyblok.com/f/47007/x/8e101e06f9/mobile-app-trends-2026.pdf',
  appsflyer: 'AppsFlyer, 24 Apr 2025. AppsFlyer Data Shows Market Adaptation to Privacy-First Ecosystem Four Years After ATT. appsflyer.com/company/newsroom/pr/post-att-growth/',
  gps2025: 'Anthony Chavez, Google, 17 Oct 2025. Update on Plans for Privacy Sandbox Technologies. privacysandbox.google.com/blog/update-on-plans-for-privacy-sandbox-technologies',
  gps2022: 'Anthony Chavez, Google, 16 Feb 2022. Introducing the Privacy Sandbox on Android. blog.google/products/android/introducing-privacy-sandbox-android/',
  playad: 'Google Play Console Help. Advertising ID. support.google.com/googleplay/android-developer/answer/6048248',
  eac: 'US Election Assistance Commission. Voter Roll Privacy, state table (last updated 3 Jan 2023; its sources include NCSL’s page). eac.gov/sites/default/files/2024-03/Voter_Roll_Privacy.pdf',
  kochavaorder: 'FTC v. Kochava, Inc., No. 2:22-cv-00377-BLW (D. Idaho). Stipulated Order for Injunction and Other Relief, entered 25 Jun 2026. ftc.gov/system/files/ftc_gov/pdf/Kochava-Order.pdf',
  fedscoop: 'John Hewitt Jones, FedScoop, 5 Apr 2022. FBI purchases 5,000 licenses for Babel X social media OSINT tool. fedscoop.com/babel-x-fbi-purchases-5000-licenses/',
  aclu: 'American Civil Liberties Union, 18 Jul 2022. New Records Detail DHS Purchase and Use of Vast Quantities of Cell Phone Location Data. aclu.org/press-releases/new-records-detail-dhs-purchase-and-use-vast-quantities-cell-phone-location-data-0',
  cbppta: 'DHS Privacy Office. Privacy Threshold Analysis, AdID Efficacy Pilot (CBP, OFO/NTC), approved 30 Sep 2020, in CBP’s FOIA production to the ACLU (file dated 6 Oct 2023), pp. 22 to 33. assets.aclu.org/live/uploads/2022/07/2023-10-06-CBPs-Additional-Production.pdf',
  citizenlab: 'Christl, Perry, Garcia, Anstis and Deibert, Citizen Lab, 9 Apr 2026. Uncovering Webloc: An Analysis of Penlink’s Ad-based Geolocation Surveillance Tech. citizenlab.ca/research/analysis-of-penlinks-ad-based-geolocation-surveillance-tech/',
  googleads: 'Google Privacy & Terms. Advertising (how to delete the advertising ID on an Android device). policies.google.com/technologies/ads',
  samsung: 'Samsung US Support. Use Security and privacy settings on Galaxy phones and tablets. samsung.com/us/support/answer/ANS00088122',
  apple: 'Apple Support, 19 Dec 2025. If an app asks to track your activity. support.apple.com/en-us/102420',
  // Added by the recheck of 30 Oct 2026, for the two ledger rows of section 06.
  ftcgravypr: 'Federal Trade Commission, 3 Dec 2024. FTC Takes Action Against Gravy Analytics, Venntel for Unlawfully Selling Location Data Tracking Consumers to Sensitive Sites. ftc.gov/news-events/news/press-releases/2024/12/ftc-takes-action-against-gravy-analytics-venntel-unlawfully-selling-location-data-tracking-consumers',
  ftcmwpr: 'Federal Trade Commission, 3 Dec 2024. FTC Takes Action Against Mobilewalla for Collecting and Selling Sensitive Location Data. ftc.gov/news-events/news/press-releases/2024/12/ftc-takes-action-against-mobilewalla-collecting-selling-sensitive-location-data',
};
const KEYS = Object.keys(SRC);
const c = (...k: string[]) => k.map((x) => {
  const i = KEYS.indexOf(x);
  if (i < 0) throw new Error(`the-night-pin: no source "${x}"`);
  return `[${String(i + 1).padStart(2, '0')}]`;
}).join(' ');
const sources = KEYS.map((k) => SRC[k]);
const graph = articleGraph(ed, { alternativeHeadline: `Printed as ${ed.print}`, sources });
---
<Base title={pageTitle(ed)} ogTitle={ed.seoTitle} description={describe(ed)} path={ed.path} ogImage={`/og/${ed.slug}.png`} schema={[graph]} published={ed.date} noindex={DRAFT} modified={ed.modified}>
  <main id="main">
    <section class="surface cover" aria-label="Cover">
      <RoseField layers={cover} seed={seedDrift(ed.seed)} class="rose cover-rose" />
      <Masthead right={DRAFT ? 'Draft' : undefined} />
      <div class="grid cover-grid">
        <h1 class="c-full display" data-flex="cursor">The Night<br><span class="acid">Pin</span>{ed.dek && <span class="dek"><span class="sr">: </span>{ed.dek}</span>}</h1>
        <p class="c-a lede">{ed.lede}</p>
        <Formats slug={ed.slug} />
      </div>
      <div class="foot mono cover-foot">
        <span>{ed.dateLabel} · {SITE.author}</span>
        <span>r = cos(kθ) · seed {ed.seed} · k 5/7/3</span>
      </div>
    </section>
    <FilmPlayer slug={ed.slug} />

    <Section n="00" title="The admission" ground="bottle" id="admission">
      <div class="c-a prose">
        <p class="num figure fig-l" aria-hidden="true">18.03.2026</p>
        <p>On 18 March 2026, Senator Ron Wyden asked the director of the FBI whether the Bureau would commit to not buying Americans’ location data. Kash Patel did not commit. He said the FBI “uses all tools” to do its mission, and then: “We do purchase commercially available information that is consistent with the Constitution and the laws under the Electronic Communications Privacy Act” and “it has led to some valuable intelligence for us …” <span class="cite">{c('tcfbi')}</span></p>
        <p>According to Politico, it was the first time since 2023 that the FBI had confirmed buying access to data from data brokers. The Bureau holds that it needs no warrant to use the data it buys. As of March 2026 that theory had not been tested in court. <span class="cite">{c('tcfbi')}</span></p>
        <p>What follows is the stack that sentence refers to. It has six layers. Four of them watch things. Two of them watch people. The interesting part is not any single layer. It is the one lookup where the last two meet.</p>
        <p class="mono reg">Position</p>
        <p class="beat">Nothing in this stack is secret, and nearly all of it is for sale. The step that turns it into surveillance of a named person is a single database join, and in most US states the input that makes that join possible is not supposed to be used commercially at all.</p>
      </div>
      <div class="c-b">
        <p class="mono-b how">How to read</p>
        <dl class="rail">
          <dt>Measured</dt><dd>Text carrying a bracketed number points to a primary or first-hand source in section 17.</dd>
          <dt>Correction</dt><dd>Where a popular claim about this stack is wrong, it is marked and the evidence is given.</dd>
          <dt>View</dt><dd>The author’s opinion. Set on its own surface, signed, and labelled as not reporting.</dd>
        </dl>
      </div>
    </Section>

    <Section n="01" title="The stack" id="stack">
      <figure class="c-full stack-fig">
        <figcaption class="mono">Six layers, top to bottom · 1 to 4 watch things, 5 and 6 watch people</figcaption>
        <ol class="layers">
          {stack.map(([n, name, src, sees]) => (
            <li class:list={[n === '06' && 'hot']}>
              <span class="mono ln">{n}</span>
              <span class="lname">{name}</span>
              <span class="lsrc"><b>{src}</b><br>{sees}</span>
            </li>
          ))}
        </ol>
      </figure>
      <div class="c-a prose">
        <p>Layers one to four are about infrastructure, traffic and objects. They move markets and they interest militaries, but on their own they rarely name anyone. Layers five and six are about bodies. The rest of this edition walks up the stack in order, and corrects the version of it that circulates.</p>
      </div>
    </Section>

    <Section n="02" title="Structure" ground="bottle" acid id="structure">
      <div class="c-a prose">
        <p>Shodan is a search engine for machines. It crawls the internet and, in its words, gathers information about “all devices directly connected to the Internet”, webcams and industrial control systems among them. You can search it by port, by product, by country, by the network that owns the address. <span class="cite">{c('shodan')}</span></p>
        <p>It is the base map. It tells you where the infrastructure is and what it runs. It does not tell you who is using it. A camera on Shodan is a camera, not a person.</p>
      </div>
    </Section>

    <Section n="03" title="Network" id="network">
      <div class="c-a prose">
        <p class="num figure fig-m" aria-hidden="true">90%+</p>
        <p>NetFlow is the metadata of internet traffic. It records which address talked to which, when, on what port, and how much. It doesn’t record what was said. <span class="cite">{c('cisco', 'cymru')}</span></p>
        <p>That makes it sound harmless until you see the scale it is sold at. A US government procurement record reviewed by Vice describes Team Cymru’s Augury product as drawing on over 550 collection points worldwide and being updated with at least 100 billion new records each day. It claims to cover over 90 percent of the world’s internet traffic, Vice reported. Its buyers included several branches of the US military. Vice found that the Navy, Army, Cyber Command and the Defense Counterintelligence and Security Agency paid at least $3.5 million between them for access. <span class="cite">{c('iapp')}</span></p>
      </div>
      <figure class="c-b field flow" aria-label="An illustrative flow record, with documentation addresses, not real traffic">
        <figcaption class="mono">Illustrative flow record · documentation addresses, not real traffic</figcaption>
        <p class="mono-b rec"><span>SRC 203.0.113.7</span> <span>DST 198.51.100.24</span> <span>PORT 443</span> <span>BYTES 18,442</span> <span>T 14:02:11</span></p>
        <p class="note">There’s no content in it, only who, where, when and how much.</p>
      </figure>
    </Section>

    <Section n="04" title="Attention" ground="bottle" id="attention">
      <div class="c-a prose">
        <p class="num figure fig-l" aria-hidden="true">$10,000,000</p>
        <p>Panels estimate what people download, open and stream. Investment firms buy the estimates because app usage moves before revenue does, so a good panel lets a fund see a quarter before the company reports it.</p>
        <p>The SEC’s first securities-fraud case against an alternative-data vendor came out of this layer. On 14 September 2021 the SEC settled with App Annie and its co-founder, Bertrand Schmitt. According to the SEC’s order, App Annie had told the companies sharing their app data that it would be aggregated and anonymised. From late 2014 to mid-2018 it used the non-aggregated, non-anonymised data to adjust the estimates it sold to trading firms, while telling those firms its process respected the consents it had obtained. App Annie and Schmitt neither admitted nor denied the findings. App Annie agreed to pay a $10 million penalty. Schmitt agreed to pay a $300,000 penalty and accepted a three-year bar from serving as an officer or director of a public company. <span class="cite">{c('sec')}</span></p>
        <p>The lesson for anyone building on this stack is that the legal risk lives in provenance, not in the model. A clean model trained on dirty data is a dirty product.</p>
      </div>
    </Section>

    <Section n="05" title="Orbit" acid id="orbit">
      <div class="c-a prose">
        <p>The most famous alternative dataset is also the most innocent. Satellites photograph retailers’ parking lots, and software counts the cars.</p>
        <p>Researchers at Berkeley Haas studied 4.7 million daily parking-lot observations from RS Metrics, later combined with Orbital Insight’s data, covering 67,078 stores belonging to 44 major US retailers from 2011 to 2017. A strategy that traded on the data, buying retailers with rising counts and shorting those with falling ones, beat the market by about 4.6 percent, net of stock-loan fees, in the three days around earnings announcements. The edge was largest on the short side: funds bet against retailers heading for bad quarters while individual investors, who can see short interest only twice a month and with a lag, were buying the same stocks. <span class="cite">{c('jfqa', 'haas')}</span></p>
        <p>Nobody in a parking lot is identified. That is why this layer is legal almost everywhere, and why it is the version funds talk about in public.</p>
      </div>
      <figure class="c-b field lots" aria-label="Illustration: two parking lots of 100 spaces, Quarter A 82 percent full, Quarter B 41 percent full">
        <figcaption class="mono">Illustration · two lots, two quarters</figcaption>
        {lots.map(([q, n, spaces]) => (
          <div class="lot-wrap">
            <p class="mono-b">{q} · {n}% full</p>
            <div class="lot" aria-hidden="true">{spaces.map((t) => (<span class:list={['sp', t && 'car']}></span>))}</div>
          </div>
        ))}
      </figure>
    </Section>

    <Section n="06" title="The device" ground="bottle" id="device">
      <div class="c-a prose">
        <p>Every ad inside a free app is sold in an auction that lasts a fraction of a second. To run it, the app broadcasts a bid request. Depending on permissions, that request can carry the phone’s advertising ID, GPS coordinates, IP address, device details, inferred interests and the app in use. Every bidder receives it, including the ones that lose. <span class="cite">{c('eff', 'ftcmw')}</span> EFF’s summary is blunt: once data is broadcast this way, “it’s almost impossible to know who receives it or control how it’s used.” <span class="cite">{c('eff')}</span></p>
        <p>The losing bidders are a business of their own. Anyone posing as an ad buyer can get the data, EFF says, and data brokers have used that “to harvest data at a staggering scale.” The FTC alleged that Mobilewalla kept the bid request “even when it did not have a winning bid” and sold access to the data. The information in a bid request is called bidstream data. <span class="cite">{c('eff', 'ftcmw')}</span></p>
      </div>
      <figure class="c-full field fan" aria-label="One bid request, from a phone through an exchange to twelve bidders. One wins the ad. Eleven receive the data, and can keep it.">
        <figcaption class="mono">One bid request, twelve bidders · illustration</figcaption>
        <div class="fan-row" aria-hidden="true">
          <div class="fan-src">
            <div class="ph">
              <span class="mono carries"><span>Ad ID</span><span class="dot"> · </span><span>GPS</span><span class="dot"> · </span><span>IP</span></span>
              <span class="node phone mono-b">Phone</span>
              <span class="wire"></span>
            </div>
            <span class="node ex mono-b">Exchange</span>
          </div>
          <div class="spray"><svg viewBox="0 0 100 120" preserveAspectRatio="none">
            {spray.map(({ won, y }) => (<line x1="0" y1="60" x2="100" y2={y} stroke={won ? '#FFFFFF' : '#00B24F'} stroke-width={won ? 3 : 1.6} vector-effect="non-scaling-stroke" />))}
          </svg></div>
          <ol class="bidders">
            {bidders.map((won) => (<li class:list={['mono', won && 'won']}>{won ? 'Wins the ad' : 'Receives the data'}</li>))}
          </ol>
        </div>
        <p class="mono note">One wins the ad. Eleven receive the data, and can keep it.</p>
      </figure>
      <dl class="c-full ledger-stats">
        <dt class="num">About 1,000,000,000 phones.</dt>
        <dd>Gravy Analytics and its subsidiary Venntel claimed, according to the FTC in December 2024, to collect more than 17 billion signals a day from about a billion mobile devices. <span class="cite">{c('record', 'ftcgravypr')}</span></dd>
        <dt class="num">More than 500,000,000 advertising IDs</dt>
        <dd>paired with precise location were collected by Mobilewalla between January 2018 and June 2020, the FTC alleges. Mobilewalla itself estimated that about 60 percent of its consumer data in that period came from ad auctions. <span class="cite">{c('record', 'ftcmw', 'ftcmwpr')}</span></dd>
        <dt class="num">More than 30,000,000 location points</dt>
        <dd>in one sample leaked from Gravy Analytics in January 2025, including devices at the White House, the Kremlin, Vatican City and military bases. Apps named in the data included dating, fitness and transit apps. <span class="cite">{c('tcgravy')}</span></dd>
      </dl>
    </Section>

    <Section n="07" title="What the bid request does not carry" acid id="overstated">
      <div class="c-a prose">
        <p class="mono reg">Correction</p>
        <p>The popular telling of this stack overstates layer five in four ways.</p>
        <p><strong>Card purchases.</strong> The claim that bidstream data shows “what they purchase via credit-card point-of-sale systems” is wrong. The industry’s bid request standard, OpenRTB 2.6, has no field for a card transaction. A bid request carries the ID, location, IP, device, app and inferred interests, and can carry audience segments from outside data providers. It doesn’t carry your receipt. <span class="cite">{c('openrtb', 'eff')}</span></p>
        <p><strong>A guaranteed iPhone ID.</strong> Since Apple’s App Tracking Transparency prompt in 2021, an app has to ask before it can use the iPhone’s advertising ID. <span class="cite">{c('appledev')}</span> Measured opt-in rates sit at roughly 35 to 50 percent globally, depending on whose panel you trust, and lower for some kinds of app. Many iPhones in the auction show no ID at all. <span class="cite">{c('moburst', 'adjust', 'appsflyer')}</span></p>
        <p><strong>Always GPS.</strong> 404 Media found that large amounts of the leaked Gravy data were location inferred from IP addresses rather than the phone’s precise GPS coordinates. Plenty of points in these datasets give an approximate location, not a doorstep. <span class="cite">{c('tcgravy')}</span></p>
        <p><strong>But Android.</strong> Google said on 17 October 2025 that it was retiring Privacy Sandbox on Android, which it had built to run ads without the Android advertising ID. The ID stays unless the user deletes it. <span class="cite">{c('gps2025', 'gps2022', 'playad', 'playio')}</span></p>
        <p>None of this makes the layer weak. It makes it uneven, and an analyst who treats it as complete will be confidently wrong about the people it misses.</p>
      </div>
    </Section>

    <Section n="08" title="The night pin" ground="bottle" id="pin">
      <div class="c-a prose">
        <p>An advertising ID is a long random string. It is pseudonymous, not anonymous, and it stops being even that the moment you ask where it sleeps.</p>
        <p>A phone that comes to rest at the same coordinate between 22:00 and 06:00, night after night, has a home. A home has an address. An address has registered voters. That single lookup, from coordinate to address to voter record, is where a string of letters becomes a name and, often, a year or date of birth, a party and a voting history.</p>
        <p>This is the night pin. Everything above it in this edition is context. This is the mechanism.</p>
      </div>
      <figure class="c-full field clock" aria-label="Illustration: one phone's pings around a 24-hour clock. By day they scatter; between 22:00 and 06:00 they gather at one point, the night pin, which leads to a home coordinate, a street address, a name, a year or date of birth, a party and a turnout history.">
        <figcaption class="mono">Illustration · one phone, 24 hours · the arc marks 22:00 to 06:00</figcaption>
        <div class="clock-row">
          <div class="dial" style={`--pin: ${((CK.cx + 24) / CK.W * 100).toFixed(3)}%`}>
          <svg viewBox={`0 0 ${CK.W} ${CK.H}`} aria-hidden="true">
            <circle cx={CK.cx} cy={CK.cy} r={CK.R} fill="none" stroke="#063B22" stroke-width="26" />
            <path d={`M ${f1(AX)} ${f1(AY)} A ${CK.R} ${CK.R} 0 0 1 ${f1(BX)} ${f1(BY)}`} fill="none" stroke="#00B24F" stroke-width="26" />
            <text x={f1(L22X - 6)} y={f1(L22Y - 4)} text-anchor="end" class="svg-t">22:00</text>
            <text x={f1(L06X + 24)} y={f1(L06Y - 30)} class="svg-t">06:00</text>
            <text x={f1(LDX + 10)} y={f1(LDY + 26)} text-anchor="middle" class="svg-t">DAYTIME</text>
            {day.map(([x, y]) => (<rect x={f1(x - 4)} y={f1(y - 4)} width="8" height="8" fill="#FFFFFF" />))}
            {night.map(([x, y]) => (<rect x={f1(x - 4)} y={f1(y - 4)} width="8" height="8" fill="#00B24F" />))}
            <circle cx={CK.cx} cy={CK.cy} r="11" fill="#FF1F5A" />
            <path class="j-narrow" d={`M ${CK.cx + 24} ${CK.cy} H ${CK.W - 1} V ${CK.H}`} fill="none" stroke="#FF1F5A" stroke-width="2" vector-effect="non-scaling-stroke" />
          </svg>
          <span class="link" aria-hidden="true"></span>
          </div>
          <div class="chain-w">
            <p class="mono lookup">One lookup</p>
            <ol class="chain">
              {chain.map(([s, names]) => (<li class:list={['mono', !names && 'adds']}>{s}</li>))}
            </ol>
          </div>
        </div>
      </figure>
    </Section>

    <Section n="09" title="Four points" id="proof">
      <div class="c-a prose">
        <p class="num figure fig-m" aria-hidden="true">4 → 95%</p>
        <p>The idea that a location trail can be anonymised has been tested, and it failed. In 2013, researchers studying 15 months of mobility data for 1.5 million people found that four points in space and time were enough to single out 95 percent of them. That was at hourly resolution, using cell-tower locations, which is coarser than the GPS in a modern bid request. <span class="cite">{c('crowd')}</span></p>
        <p>In December 2019 the New York Times obtained a file of more than 50 billion location pings from over 12 million phones, covering several months of 2016 and 2017. Its reporters followed military officials, police and lawyers. One phone belonged to a Microsoft employee who visited an Amazon office and took a job there a month later. <span class="cite">{c('nyt')}</span></p>
        <p>That last example is the whole trading pitch in one sentence. It’s also why the pitch runs into the law.</p>
      </div>
      <figure class="c-b field hundred" aria-label="Of every 100 people, four points single out 95">
        <figcaption class="mono">Of every 100 people, four points single out 95 <span class="cite">{c('crowd')}</span></figcaption>
        <div class="cells-100" aria-hidden="true">{hundred.map((lit) => (<span class:list={['px', lit && 'lit']}></span>))}</div>
      </figure>
    </Section>

    <Section n="10" title="The voter file" ground="bottle" id="file">
      <div class="c-a prose">
        <p>A voter file is the most reliable identity list in American public life. Almost every state’s file carries name and home address. Many add party, voting history and year or full date of birth. Some add phone numbers; a few add sex or race. <span class="cite">{c('ncsl', 'eac')}</span></p>
        <p>It is public, but it is not free to use however you like. According to the National Conference of State Legislatures:</p>
        <ul class="key">
          <li><span class="sw a" aria-hidden="true"></span><span><strong>29 states</strong> restrict use of the voter list to non-commercial purposes.</span></li>
          <li><span class="sw m" aria-hidden="true"></span><span><strong>9 more</strong> restrict it to election, political or government purposes.</span></li>
          <li><span class="sw d" aria-hidden="true"></span><span><strong>12</strong> are silent on use. NCSL’s survey records no state that expressly allows any use. <span class="cite">{c('ncsl')}</span></span></li>
        </ul>
        <p class="mono reg">Correction</p>
        <p>A trading desk is a commercial user. The popular pitch, which grounds bidstream profiles in voter files to sharpen trading signals, skips the fact that in 38 states the input is restricted against exactly that.</p>
      </div>
      <figure class="c-b field waffle-fig" aria-label="Fifty states: 29 restrict the voter list to non-commercial use, 9 to election, political or government use, 12 are silent on use">
        <figcaption class="mono">Fifty states, one cell each <span class="cite">{c('ncsl')}</span></figcaption>
        <div class="waffle" aria-hidden="true">{waffle.map((t) => (<span class:list={['w', t]}></span>))}</div>
        <dl class="wkey" aria-hidden="true">
          <div><dt class="num">29</dt><dd class="mono">Non-commercial only</dd></div>
          <div class="m"><dt class="num">9</dt><dd class="mono">Election, political or government</dd></div>
          <div><dt class="num">12</dt><dd class="mono">Silent on use</dd></div>
        </dl>
      </figure>
    </Section>

    <Section n="11" title="Where the join is legal" acid id="legal">
      <div class="c-a prose">
        <p>The join is legal, and growing, in the place the voter file was built for: politics.</p>
        <p>On 18 June 2026, the ad-tech company Nexxen and the data firm L2 launched VoterMatch. It combines L2’s national voter file with Nexxen’s log-level ad data so that campaigns can see, in the companies’ words, “which voters have been reached, and how frequently”, which the release itself calls “voter-level modeled exposure”. The launch release does not describe the matching method or give match rates. <span class="cite">{c('nexxen')}</span></p>
      </div>
      <figure class="c-full join" aria-label="Illustration: VoterMatch joins a voter file, name, address, party and turnout, to log-level ad data, an ad ID, an impression, its time and the app, and gives reach and frequency per voter. The release names the two datasets, not their fields or how they are matched.">
        <figcaption class="mono">Illustration · the release names the two datasets, not their fields or how they are matched <span class="cite">{c('nexxen')}</span></figcaption>
        <div class="join-row" aria-hidden="true">
          <div class="jl">
            <p class="mono jh">Voter file</p>
            <ul class="mono-b"><li>Name</li><li>Address</li><li>Party</li><li>Turnout</li></ul>
          </div>
          <span class="jw jw1"></span>
          <span class="jbox mono-b">Join</span>
          <span class="jw jw2"></span>
          <div class="jr">
            <p class="mono jh">Log-level ad data</p>
            <ul class="mono-b"><li>Ad ID</li><li>Impression</li><li>Time</li><li>App</li></ul>
          </div>
          <p class="mono jo">Reach and frequency, per voter, modeled</p>
        </div>
      </figure>
      <div class="c-a prose">
        <p>Layers five and six have also been combined in public, outside a campaign. In June 2020 Mobilewalla published the race, gender and age mix of protesters in New York, Los Angeles, Minneapolis and Atlanta, derived from phone data. Its founder and chief executive, Anindya Datta, said it had not been prepared for law enforcement or a public agency. <span class="cite">{c('mobilewalla')}</span> In December 2024 the FTC alleged that Mobilewalla had built audience segments of protesters and of women visiting health clinics, and its order bars the company from selling sensitive location data. <span class="cite">{c('record')}</span></p>
      </div>
    </Section>

    <Section n="12" title="The three trades" ground="bottle" id="trades">
      <div class="c-a prose">
        <p>The pitch that circulates offers three ways to turn the full stack into trading returns. Checked against the record:</p>
      </div>
      <div class="c-full trades">
        <div class="trade field">
          <p class="mono n">01</p>
          <p class="trade-t mono-b">Foot traffic</p>
          <p class="verdict display acid">Works.</p>
          <p class="note">Sold as counts per store, not per person. In 2019 Thasos offered quantitative hedge funds daily visit counts for more than 600,000 US properties, built from phone location data. The satellite studies show the same edge from orbit. <span class="cite">{c('thasos', 'haas')}</span></p>
        </div>
        <div class="trade field">
          <p class="mono n">02</p>
          <p class="trade-t mono-b">Named people</p>
          <p class="verdict display">Barred at the source.</p>
          <p class="note">Tracking specific people at offices and homes is what the FTC has spent two years shutting down. The Gravy, Venntel and Mobilewalla orders bar the sale of sensitive location data, and Mobilewalla’s explicitly covers data showing where people live. Kochava’s order, entered by a federal court in June 2026, bars the sale of sensitive location data unless the company has a direct relationship with the consumer, the consumer gives affirmative express consent, and the data is used for a service the consumer asked for. <span class="cite">{c('record', 'kochava', 'kochavaorder')}</span> And a vendor that sells data obtained by breaking the promise under which it was shared, while telling buyers otherwise, is in App Annie’s position. <span class="cite">{c('sec')}</span></p>
        </div>
        <div class="trade field">
          <p class="mono n">03</p>
          <p class="trade-t mono-b">Voter blocks</p>
          <p class="verdict display">Unproven.</p>
          <p class="note">In 38 states the input is restricted against commercial use, and there is no published evidence that location-weighted voter blocks forecast elections better than polling. <span class="cite">{c('ncsl')}</span></p>
        </div>
      </div>
      <div class="c-a prose">
        <p>The legitimate trade is the boring one. The exotic trades are either illegal at the source or untested.</p>
      </div>
    </Section>

    <Section n="13" title="Who buys the whole stack" id="buyers">
      <div class="c-a prose">
        <p class="num figure fig-l" aria-hidden="true">113,654</p>
        <p>If funds mostly buy aggregates, who buys at the level of a person? The public record answers it. States.</p>
      </div>
      <dl class="c-full defs">
        <div><dt class="mono-b">FBI.</dt><dd>A 2022 contract, reported then as worth up to $27 million, for 5,000 licences to Babel Street’s Babel X, a text analytics tool for searching social media and other online sources, bought through the reseller Panamerica Computers. <span class="cite">{c('record', 'fedscoop')}</span></dd></div>
        <div><dt class="mono-b">DHS.</dt><dd>According to the ACLU, about 113,654 location points obtained over three days in 2018. <span class="cite">{c('aclu')}</span></dd></div>
        <div><dt class="mono-b">CBP.</dt><dd>A pilot dated 1 May 2019 to 1 May 2021 to test “commercially available marketing location data associated with Advertising IDs”. CBP’s own privacy assessment names two sources, apps’ SDKs and ad auctions: “RTB-sourced location data is recorded when an advertisement is served.” <span class="cite">{c('eff', 'cbppta')}</span></dd></div>
        <div><dt class="mono-b">ICE.</dt><dd>Bought Webloc licences for September 2025 to September 2026. EFF says the tool gathers the locations of millions of phones and can filter them by advertising ID. <span class="cite">{c('eff', 'citizenlab')}</span></dd></div>
        <div><dt class="mono-b">The US military.</dt><dd>Several branches bought access to Augury, which carries NetFlow and, in some cases, email and browsing data. <span class="cite">{c('iapp')}</span></dd></div>
      </dl>
      <div class="c-a prose">
        <p>The intelligence community has said as much about itself. A January 2022 report by a senior advisory group to the Director of National Intelligence, declassified in June 2023, states that commercially available information “includes information on nearly everyone”, and that it could be used “to cause harm to an individual’s reputation, emotional well-being, or physical safety.” <span class="cite">{c('odni')}</span></p>
      </div>
    </Section>

    <Section n="14" title="The law" ground="bottle" id="law">
      <div class="c-a">
        <p class="num figure fig-m" aria-hidden="true">29.06.26</p>
      </div>
      <dl class="c-full defs">
        <div><dt class="mono-b">Decided.</dt><dd>On 29 June 2026 the Supreme Court held in Chatrie v. United States that police “conducted a Fourth Amendment search when they acquired Chatrie’s location data from Google”, in this case through a geofence warrant. Justice Kagan wrote for the Court; the vote was 6 to 3. Whether the warrant met the particularity and probable-cause requirements at each step, and whether the good-faith exception still lets the evidence in, went back to the Fourth Circuit. <span class="cite">{c('chatrie')}</span></dd></div>
        <div><dt class="mono-b">Not decided.</dt><dd>Whether buying the same kind of data is a search. The FBI’s position that it needs no warrant to use purchased data had not been tested in court as of March 2026 <span class="cite">{c('tcfbi')}</span>, and as of August no court appeared to have squarely resolved it. <span class="cite">{c('cln')}</span></dd></div>
        <div><dt class="mono-b">Pending.</dt><dd>The Government Surveillance Reform Act, introduced on 12 March 2026 by Senators Wyden and Lee with Representatives Davidson and Lofgren, would, in its sponsors’ words, ban “the federal government from buying Americans’ data from data brokers without a warrant.” <span class="cite">{c('wyden', 'lofgren')}</span> In its text, section 201 says a federal law enforcement agency “may not obtain in exchange for anything of value covered personal data” from a non-government organisation, with narrow exceptions, and section 404 says “an element of the intelligence community may not acquire a dataset that includes covered data”, with listed exceptions, among them a FISA order or a court’s authorisation of its collection. <span class="cite">{c('bill')}</span> It has not passed. It is written as a four-year renewal of Section 702, the government’s warrantless foreign-intelligence surveillance law, which lapsed in June 2026 after Congress failed to agree on reauthorization; existing authorizations run to March 2027. <span class="cite">{c('bill', 'proton', 'brennan')}</span> As of late October no federal restriction on government data purchases had been enacted. <span class="cite">{c('brennan')}</span> Montana in 2025 became the first state to pass a law blocking the government from buying sensitive data it would otherwise need a warrant to obtain. <span class="cite">{c('eff')}</span></dd></div>
        <div><dt class="mono-b">Settled.</dt><dd>The FTC’s orders against Gravy, Venntel and Mobilewalla, and the Kochava order entered in June 2026, restrict the sale of sensitive location data by those companies. They do not regulate the buyers. <span class="cite">{c('record', 'kochavaorder')}</span></dd></div>
      </dl>
    </Section>

    {/* The View is signed by Jesse James. Its wording waits on the owner:
        the source marks it JESSE TO CONFIRM OR REWRITE BEFORE PUBLISHING. */}
    <Section n="15" title="View" id="view">
      <RoseField layers={behind} class="rose divider" />
      <div class="c-a prose">
        <p class="mono reg">View · Jesse James</p>
        <p class="mono-b">Opinion. Not reporting.</p>
        <p class="beat">Chatrie put a warrant in front of the data police ask for.</p>
        <p class="beat">Nothing stands in front of the data they buy.</p>
        <p class="beat acid">The cheapest warrant is a purchase order.</p>
      </div>
    </Section>

    <Section n="16" title="The off switch" ground="bottle" acid id="off">
      <div class="c-a prose">
        <p>Layer five is the only layer in this stack that you control directly.</p>
      </div>
      <dl class="c-full defs">
        <div><dt class="mono-b">Android.</dt><dd>Settings, Privacy, Ads, Delete advertising ID. The exact path varies by manufacturer. <span class="cite">{c('googleads', 'samsung')}</span></dd></div>
        <div><dt class="mono-b">iPhone.</dt><dd>Settings, Privacy &amp; Security, Tracking. Turn off Allow Apps to Request to Track. <span class="cite">{c('apple')}</span></dd></div>
        <div><dt class="mono-b">Location.</dt><dd>Give location only to apps that need it. Where an app needs it, allow it only while the app is in use, and turn off precise location wherever the app still works without it. <span class="cite">{c('eff')}</span></dd></div>
      </dl>
      <div class="c-a prose">
        <p>That doesn’t remove you from the voter file, and it doesn’t touch the IP address every connection carries. It does take the most precise identifier out of the auction.</p>
      </div>
    </Section>

    <SameThread slug={ed.slug} />
    <Section n="17" title="Sources" id="sources">
      <ol class="c-full sources">
        {sources.map((s, i) => (<li><span class="mono-b n">{String(i + 1).padStart(2, '0')}</span><span>{s}</span></li>))}
      </ol>
    </Section>

    <EditionEnd slug={ed.slug} />
  </main>
</Base>


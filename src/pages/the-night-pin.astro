     surface (a ground, not type at scale). */
  .stack-fig figcaption { margin-bottom: 14px; }
  .layers { list-style: none; margin: 0 calc(-1 * var(--gutter)); padding: 0; display: grid; row-gap: 8px; }
  .layers li { display: grid; grid-template-columns: 2.2em minmax(0, 13em) minmax(0, 1fr); column-gap: clamp(14px, 2.4vw, 28px); align-items: center; min-height: clamp(72px, 7.4vw, 108px); padding: 14px var(--gutter); background: var(--bottle); }
  .layers .ln { color: var(--flash); }
  .layers .lname { font-variation-settings: 'opsz' 96, 'wdth' 75, 'wght' 800; font-size: clamp(24px, 3.8vw, 56px); text-transform: uppercase; line-height: .9; overflow-wrap: anywhere; }
  .layers .lsrc { font-size: clamp(15px, 1.35vw, 19px); line-height: 1.3; }
  .layers .lsrc b { font-variation-settings: 'opsz' 14, 'wdth' 100, 'wght' 700; }
  .layers li.hot { background: var(--acid); color: var(--void); }
  .layers li.hot .ln { color: var(--void); }
  @media (max-width: 560px) {
    .layers li { grid-template-columns: 2em minmax(0, 1fr); row-gap: 6px; align-items: baseline; }
    .layers .lsrc { grid-column: 2; }
  }

  /* One flow record, broken between its fields so it never leaves a phone's frame. */
  .flow .rec { margin-top: 14px; color: var(--flash); line-height: 2; }
  .flow .rec span { white-space: nowrap; margin-right: .8em; }

  /* Two lots, a hundred spaces each. */
  .lots { display: grid; row-gap: 18px; }
  .lot-wrap .mono-b { margin-bottom: 8px; }
  .lot { display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); gap: 3px; max-width: 520px; }
  .sp { display: block; aspect-ratio: 1 / 1.6; background: var(--void); }
  .sp.car { background: var(--flash); }

  /* The fan-out, as the carousel draws it: the phone in Acid, what it sends
     over it, the exchange in Flash, twelve lines fanning to twelve bidders,
     the winner's line and mark in Flash, the rest in Malachite. On a phone the
     phone stands over the exchange and the fan keeps its shape. */
  .fan-row { display: grid; grid-template-columns: max-content minmax(40px, 320px) max-content; align-items: center; margin-top: 48px; }
  .fan-src { display: flex; align-items: center; }
  .ph { position: relative; display: flex; align-items: center; }
  .carries { position: absolute; left: 0; bottom: 100%; margin-bottom: 10px; white-space: nowrap; color: var(--malachite); }
  .node { display: block; padding: 12px 16px; }
  .node.phone { background: var(--acid); color: var(--void); padding-block: 30px; }
  .node.ex { background: var(--flash); color: var(--void); }
  .wire { display: block; width: clamp(24px, 4vw, 64px); height: 3px; background: var(--malachite); }
  .spray { position: relative; align-self: stretch; }
  .spray svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bidders { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-rows: 1fr; }
  .bidders li { display: flex; align-items: center; gap: 12px; padding-block: 5px; color: var(--malachite); }
  .bidders li::before { content: ''; flex: none; width: 10px; height: 10px; background: currentColor; }
  .bidders li.won { color: var(--flash); }
  @media (max-width: 760px) {
    .fan-row { grid-template-columns: max-content minmax(20px, 1fr) minmax(0, max-content); margin-top: 18px; }
    .fan-src { display: grid; grid-template-rows: 1fr auto 1fr; justify-items: start; align-self: stretch; }
    .ph { grid-row: 1; align-self: end; flex-direction: column; align-items: flex-start; }
    .carries { position: static; margin: 0 0 8px; }
    .carries > span { display: block; }
    .carries .dot { display: none; }
    .node.phone { padding-block: 18px; }
    .wire { width: 3px; height: 18px; margin-left: 20px; }
    .node.ex { grid-row: 2; padding-inline: 10px; }
    .bidders li { gap: 8px; }
  }

  /* A ledger of three counts: the figure, then what it counts. */
  .fan + .ledger-stats { margin-top: 16px; }
  .ledger-stats { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(16px, 2vw, 32px); row-gap: 22px; align-items: baseline; }
  .ledger-stats dt { font-size: clamp(22px, 2.8vw, 34px); line-height: 1.1; overflow-wrap: anywhere; }
  .ledger-stats dd { font-size: 17px; line-height: 1.5; max-width: 62ch; }
  @media (max-width: 760px) { .ledger-stats { grid-template-columns: 1fr; row-gap: 8px; } .ledger-stats dd { margin-bottom: 14px; } }

  /* The night pin, as the carousel draws it: the dial, then one Shock rose
     line from the pin to the lookup, which runs on across the gap to the
     chain. On a phone the chain drops under the dial and the line turns down
     the dial's right edge into the rule over it. */
  .clock-row { --jg: clamp(40px, 6vw, 88px); display: grid; grid-template-columns: minmax(0, 470px) max-content; align-items: center; margin-top: 12px; }
  .dial { position: relative; }
  .clock svg { display: block; width: 100%; height: auto; }
  .svg-t { font-family: 'Martian Mono', ui-monospace, monospace; font-variation-settings: 'wdth' 75, 'wght' 500; font-size: 22px; letter-spacing: .08em; fill: #00B24F; }
  .j-narrow { display: none; }
  /* One element from the pin to the lookup, so the line has no seam: it starts
     where the dial's centre is drawn (cx + 24 of the viewBox's width) and runs
     across the gap to 16 px short of the chain. */
  .clock .link { position: absolute; top: calc(50% - 1px); left: var(--pin); right: calc(16px - var(--jg)); height: 2px; background: var(--shock); }
  .chain-w { position: relative; padding-left: var(--jg); }
  .chain-w .lookup { position: absolute; left: var(--jg); bottom: 100%; margin-bottom: 18px; color: var(--shock); }
  .chain { list-style: none; margin: 0; padding: 0; display: grid; row-gap: clamp(12px, 1.6vw, 22px); }
  .chain li { font-size: clamp(13px, 1.3vw, 17px); letter-spacing: .14em; color: var(--flash); }
  .chain li.adds { color: var(--malachite); }
  @media (max-width: 760px) {
    .clock-row { grid-template-columns: minmax(0, 1fr); }

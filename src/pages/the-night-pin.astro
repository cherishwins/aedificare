    .chain-w .lookup { position: static; margin: 0 0 14px; }
  }

  /* A hundred cells as the carousel lays them, 25 by 4: the first 95 Flash,
     the last 5 Void, on the field's Bottle. */
  .cells-100 { display: grid; grid-template-columns: repeat(25, minmax(0, 1fr)); gap: clamp(2px, .3vw, 5px); max-width: 560px; margin-top: 14px; }
  .px { display: block; aspect-ratio: 1; background: var(--void); }
  .px.lit { background: var(--flash); }

  /* Fifty states, one cell each. On Bottle, so the field is Void. */
  .waffle { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; max-width: 360px; margin-top: 14px; }
  .w, .sw { display: block; aspect-ratio: 1; }
  .w.a, .sw.a { background: var(--acid); }
  .w.m, .sw.m { background: var(--malachite); }
  .w.d { background: var(--bottle); }
  .sw.d { background: var(--bottle); border: 1px solid rgba(255, 255, 255, .5); }
  /* The waffle's own key, as the carousel sets it: the count, then the rule. */
  .wkey { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 14px; max-width: 460px; margin-top: 18px; }
  .wkey dt { font-variation-settings: 'wdth' 75, 'wght' 300; font-size: clamp(30px, 3vw, 40px); letter-spacing: -.02em; line-height: 1; }
  .wkey .m dt { color: var(--malachite); }
  .wkey dd { margin-top: 8px; line-height: 1.4; }
  .key { list-style: none; margin: 0 0 1.1em; padding: 0; display: grid; row-gap: 10px; max-width: 62ch; }
  .key li { display: grid; grid-template-columns: 18px minmax(0, 1fr); column-gap: 14px; align-items: baseline; }
  .key .sw { width: 18px; height: 18px; align-self: start; margin-top: .3em; }
  .key .sw.d { background: var(--void); }

  /* The VoterMatch join, as the carousel draws it: the voter file and the ad
     data meet in one Flash box; under it what comes out. On a phone the two
     stand over and under the box. */
  .join-row { display: grid; grid-template-columns: max-content minmax(24px, 1fr) max-content minmax(24px, 1fr) max-content; grid-template-areas: "l w1 j w2 r" ". . o o o"; align-items: center; row-gap: 18px; margin-top: 22px; max-width: 760px; }
  .jl { grid-area: l; } .jr { grid-area: r; text-align: right; }
  .jw1 { grid-area: w1; } .jw2 { grid-area: w2; }
  .jw { display: block; height: 3px; background: var(--malachite); }
  .jbox { grid-area: j; display: grid; place-items: center; width: clamp(72px, 7vw, 100px); aspect-ratio: 1; background: var(--flash); color: var(--void); font-size: clamp(13px, 1.2vw, 16px); }
  .jo { grid-area: o; color: var(--malachite); }
  .join .jh { color: var(--malachite); margin-bottom: 10px; }
  .join ul { list-style: none; margin: 0; padding: 0; display: grid; row-gap: 10px; font-size: clamp(12px, 1.2vw, 15px); }
  @media (max-width: 760px) {
    .join-row { grid-template-columns: 72px minmax(0, 1fr); grid-template-areas: "l l" "w1 ." "j o" "w2 ." "r r"; column-gap: 16px; row-gap: 0; }
    .jr { text-align: left; }
    .jw { width: 3px; height: 26px; justify-self: center; }
    .jl { margin-bottom: 16px; } .jr { margin-top: 16px; }
  }

  /* The three trades, each in its own field, as The Countersign's claims. */
  .trades { display: grid; row-gap: 14px; }
  .trade { padding: clamp(18px, 3vw, 30px); }
  .trade .n { color: var(--flash); margin: 0 0 10px; }
  .trade .trade-t { font-size: clamp(18px, 2.4vw, 26px); margin: 0; }
  .trade .verdict { font-size: clamp(36px, 6vw, 84px); line-height: 1; margin: 6px 0 12px; }
  .trade .note { margin-top: 0; font-size: 16px; max-width: 70ch; }

  /* Buyers, rulings and switches: a key, then its line. */
  .defs { margin: 0; display: grid; row-gap: 0; max-width: 100ch; }
  .defs > div { display: grid; grid-template-columns: 11em minmax(0, 1fr); column-gap: 20px; align-items: baseline; padding-block: 14px; border-top: 1px solid rgba(255, 255, 255, .16); }
  .defs dt { color: var(--flash); text-transform: uppercase; letter-spacing: .1em; }
  .defs dd { margin: 0; font-size: 17px; line-height: 1.5; max-width: 70ch; }
  @media (max-width: 760px) { .defs > div { grid-template-columns: 1fr; row-gap: 4px; } }

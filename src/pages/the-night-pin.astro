---
/**
 * The Night Pin, printed as Edition 11. Ported on 30 Oct 2026 from the web
 * edition the owner uploaded beside the print (source/the-night-pin.web.md),
 * the prose verbatim. Three registers, as its How to read sets them: Measured
 * (a bracketed number points to a source in section 17, and the default),
 * Correction (where the popular telling of this stack is wrong, marked, with
 * the evidence) and View (the author's opinion, on its own surface, signed).
 * The source's one Position paragraph keeps the house register for the
 * author's position, a mono label over a beat, as Editions 01, 05 and 09 set
 * it.
 *
 * A DRAFT until its nineteen sources have been opened and checked
 * (research/the-night-pin/): no verification pass came with it, and every
 * ported edition that skipped one was wrong in ways that mattered.
 *
 * The figures are computed, never drawn by hand. The parking lots, the
 * clock's pings and the fan-out are illustrations and say so; the waffle and
 * the hundred-cell grid are counts from the text, laid out by a seeded
 * shuffle so the page builds the same picture every time.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import RoseField from '../components/RoseField.astro';
import Section from '../components/Section.astro';
import EditionEnd from '../components/EditionEnd.astro';
import Formats from '../components/Formats.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import { HOUSE } from '../lib/rose.mjs';
import { edition, LICENCE, describe, seedDrift, seedNumber } from '../lib/editions.mjs';
import { SITE, abs } from '../config.mjs';

const ed = edition('the-night-pin');
const DRAFT = !!ed.draft;
// The cover rose: the house layers at the colophon's k (5, 7, 3). Malachite
// only; Acid on the cover is spent on one word of the title.
const cover = HOUSE.map((L, i) => ({ ...L, k: ed.k[i], c: '#00B24F', o: [0.62, 0.34, 0.2][i] }));
// The View's field, Malachite only, so its surface's one Acid stays its last line.
const behind = [
  { k: 5, s: 1.0, ph: 0.13, w: 0.7, c: '#00B24F', o: 0.42 },
  { k: 7, s: 0.71, ph: 0.51, w: 0.7, c: '#00B24F', o: 0.28 },
];

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: ed.title,
  alternativeHeadline: `Printed as ${ed.print}`,
  datePublished: ed.date,
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.origin },
  url: abs(ed.path),
  mainEntityOfPage: abs(ed.path),
  license: LICENCE.url,
  isAccessibleForFree: true,
  description: ed.lede,
};

// A seeded shuffle, so a laid-out count is the same picture on every build.
const rng = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const shuffled = (n: number, r: () => number) => {
  const a = Array.from({ length: n }, (_, i) => i);
  for (let i = n - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
};
const R = rng(seedNumber(ed.seed));

// The stack, top to bottom as the print sets it. Identity is the one Acid of its surface.
const stack: [string, string, string, string][] = [
  ['06', 'Identity', 'Voter files', 'The name on the door'],
  ['05', 'Device', 'Advertising IDs from ad auctions', 'Where a phone sleeps and goes'],
  ['04', 'Orbit', 'Satellite imagery', 'Cars, tanks, ships'],
  ['03', 'Attention', 'App and web panels', 'What people open'],
  ['02', 'Network', 'NetFlow', 'Who talks to whom'],
  ['01', 'Structure', 'Shodan', 'Machines on the internet'],
];

// Two lots of 100 spaces, 82 and 41 taken. An illustration, labelled as one.
const lot = (taken: number) => { const s = new Set(shuffled(100, R).slice(0, taken)); return Array.from({ length: 100 }, (_, i) => s.has(i)); };
const lots: [string, number, boolean[]][] = [['Quarter A', 82, lot(82)], ['Quarter B', 41, lot(41)]];

// Twelve bidders; one wins the ad, eleven keep the data.
const WIN = 4;
const bidders = Array.from({ length: 12 }, (_, i) => i === WIN);

// The night pin: a 24-hour dial. Daytime pings scatter by hour; between
// 22:00 and 06:00 they come to rest at one point, marked in Shock rose (on
// Void, in the figure's field). An illustration, not data.
const CX = 200, CY = 200, RAD = 160;
const at = (h: number, r: number): [number, number] => [CX + r * Math.sin((h / 24) * 2 * Math.PI), CY - r * Math.cos((h / 24) * 2 * Math.PI)];
const f1 = (n: number) => n.toFixed(1);
const day = Array.from({ length: 22 }, () => at(6.5 + R() * 15, RAD * (0.28 + R() * 0.6)));
const [PX, PY] = at(2, RAD * 0.6);
const night = Array.from({ length: 26 }, () => [PX + (R() - 0.5) * 30, PY + (R() - 0.5) * 30]);
const [AX, AY] = at(22, RAD), [BX, BY] = at(6, RAD);
const ticks = Array.from({ length: 24 }, (_, h) => [at(h, RAD - (h % 6 ? 5 : 10)), at(h, RAD + (h % 6 ? 5 : 10))]);
const hours = [0, 6, 12, 18].map((h) => [String(h).padStart(2, '0'), ...at(h, RAD + 26)] as [string, number, number]);
const chain = ['Home coordinate', 'Street address', 'Name', 'Year of birth', 'Party', 'Turnout history'];

// Four points: of every 100 people, 95 singled out.
const unlit = new Set(shuffled(100, R).slice(0, 5));

// The voter file, 50 states: 29 non-commercial only, 9 election or
// government only, 12 silent on use. Filled in that order.
const waffle = [...Array(29).fill('a'), ...Array(9).fill('m'), ...Array(12).fill('d')];

// Sources by key, numbered in the order listed here, which is the web
// edition's own order, so every mark reads as the source prints it and stays
// right when a source is added or dropped during the check. Each entry ends
// on its URL as text (block links only; a sources list is not a link),
// scheme and www. dropped.
const SRC: Record<string, string> = {
  tcfbi: 'TechCrunch, 18 Mar 2026. FBI is buying location data to track US citizens, director confirms. techcrunch.com/2026/03/18/fbi-is-buying-location-data-to-track-us-citizens-kash-patel-wyden/',
  eff: 'Electronic Frontier Foundation, Lena Cohen and Hudson Hongo, 5 Mar 2026. Targeted advertising gives your location to the government. Just ask CBP. eff.org/deeplinks/2026/03/targeted-advertising-gives-your-location-government-just-ask-cbp',
  iapp: 'IAPP, citing Vice, 23 Sep 2022. Report: US military buys internet monitoring tool that covers 90% of web traffic. iapp.org/news/a/report-us-military-buys-internet-monitoring-tool-that-covers-90-of-web-traffic/',
  sec: 'US Securities and Exchange Commission, Press Release 2021-176, 14 Sep 2021. sec.gov/newsroom/press-releases/2021-176',
  haas: 'Berkeley Haas Newsroom, May 2019. How hedge funds use satellite images to beat Wall Street and Main Street. newsroom.haas.berkeley.edu/how-hedge-funds-use-satellite-images-to-beat-wall-street-and-main-street/',
  shodan: 'Shodan. shodan.io/',
  record: 'The Record, 3 Dec 2024. FTC actions against Gravy Analytics, Venntel and Mobilewalla. therecord.media/ftc-location-data-brokers-gravy-venntel-mobilewalla',
  tcgravy: 'TechCrunch, 13 Jan 2025. Gravy Analytics data broker breach: trove of location data threatens privacy of millions. techcrunch.com/2025/01/13/gravy-analytics-data-broker-breach-trove-of-location-data-threatens-privacy-millions/',
  moburst: 'Moburst, 2026. IDFA in 2026: what has actually happened since App Tracking Transparency launched (citing AppsFlyer and Adjust). moburst.com/blog/idfa-att-update/',
  playio: 'Playio, 2025. Privacy Sandbox shutdown and Android game marketing. blog.playio.co/privacy-sandbox-shutdown-android-game-marketing',
  crowd: 'de Montjoye, Hidalgo, Verleysen, Blondel. Unique in the Crowd: the privacy bounds of human mobility. Scientific Reports 3, 1376 (2013). nature.com/articles/srep01376',
  ncsl: 'National Conference of State Legislatures. Access to and use of voter registration lists. ncsl.org/research/elections-and-campaigns/access-to-and-use-of-voter-registration-lists.aspx',
  nexxen: 'Nexxen, 18 Jun 2026. Nexxen and L2 Data launch VoterMatch. nexxen.com/nexxen-and-l2-data-launch-votermatch-bringing-greater-precision-transparency-and-performance-to-political-advertising/',
  thasos: 'PR Newswire, 20 May 2019. Thasos launches QStreams for quantitative hedge funds. prnewswire.com/news-releases/thasos-launches-qstreams-offering-quantitative-hedge-funds-unprecedented-insight-into-consumer-foot-traffic-300852747.html',
  nyt: 'New York Times Privacy Project, 19 Dec 2019. Twelve Million Phones, One Dataset, Zero Privacy (summary via TidBITS). tidbits.com/2019/12/19/the-new-york-times-reveals-how-completely-our-every-move-is-tracked/',
  odni: 'Fortune, 13 Jun 2023, on the ODNI Senior Advisory Group report. fortune.com/2023/06/13/u-s-intelligence-agencies-commercially-available-information-spy-on-americans',
  chatrie: 'Chatrie v. United States, decided 29 Jun 2026. en.wikipedia.org/wiki/Chatrie_v._United_States',
  kochava: 'PPC Land, May 2026. FTC closes Kochava location data case with strict consent rules. ppc.land/ftc-closes-kochava-location-data-case-with-strict-consent-rules/',
  mobilewalla: 'Mobilewalla, June 2020 protest demographics report and FTC action. en.wikipedia.org/wiki/Mobilewalla',
};
const KEYS = Object.keys(SRC);
const c = (...k: string[]) => k.map((x) => {
  const i = KEYS.indexOf(x);
  if (i < 0) throw new Error(`the-night-pin: no source "${x}"`);
  return `[${String(i + 1).padStart(2, '0')}]`;
}).join(' ');
const sources = KEYS.map((k) => SRC[k]);
---
<Base title={ed.title} description={describe(ed)} path={ed.path} ogImage={`/og/${ed.slug}.png`} schema={[article]} published={ed.date} noindex={DRAFT}>
  <main id="main">
    <section class="surface cover" aria-label="Cover">
      <RoseField layers={cover} seed={seedDrift(ed.seed)} class="rose cover-rose" />
      <Masthead right={DRAFT ? 'Draft' : undefined} />
      <div class="grid cover-grid">
        <h1 class="c-full display" data-flex="cursor">The Night<br><span class="acid">Pin</span></h1>
        <p class="c-a lede">{ed.lede}</p>
        <Formats slug={ed.slug} />
      </div>
      <div class="foot mono cover-foot">
        <span>{ed.dateLabel} · {SITE.author}</span>
        <span>r = cos(kθ) · seed {ed.seed} · k 5/7/3</span>
      </div>
    </section>
    <FilmPlayer slug={ed.slug} />

    <Section n="00" title="The admission" ground="bottle" id="admission">
      <div class="c-a prose">
        <p class="num figure fig-l" aria-hidden="true">18.03.2026</p>
        <p>On 18 March 2026, Senator Ron Wyden asked the director of the FBI whether the Bureau would commit to not buying Americans’ location data. Kash Patel did not commit. He said the FBI “uses all tools” to do its mission, and then: “We do purchase commercially available information that is consistent with the Constitution and the laws under the Electronic Communications Privacy Act, and it has led to some valuable intelligence for us.” <span class="cite">{c('tcfbi')}</span></p>
        <p>It was the first time since 2023 that the FBI had confirmed buying from data brokers. The Bureau holds that data it pays for needs no warrant. No court has tested that theory. <span class="cite">{c('tcfbi')}</span></p>
        <p>What follows is the stack that sentence refers to. It has six layers. Four of them watch things. Two of them watch people. The interesting part is not any single layer. It is the one lookup where the last two meet.</p>
        <p class="mono reg">Position</p>
        <p class="beat">Nothing in this stack is secret, and nearly all of it is for sale. The step that turns it into surveillance of a named person is a single database join, and in most US states the input that makes that join possible is not supposed to be used commercially at all.</p>
      </div>
      <div class="c-b">
        <p class="mono-b how">How to read</p>
        <dl class="rail">
          <dt>Measured</dt><dd>Text carrying a bracketed number points to a primary or first-hand source in section 17.</dd>
          <dt>Correction</dt><dd>Where a popular claim about this stack is wrong, it is marked and the evidence is given.</dd>
          <dt>View</dt><dd>The author’s opinion. Set on its own surface, signed, and labelled as not reporting.</dd>
        </dl>
      </div>
    </Section>

    <Section n="01" title="The stack" id="stack">
      <div class="c-full field scroll" tabindex="0" role="region" aria-label="The six layers, top to bottom">
        <table class="layers">
          <caption class="mono">Six layers, top to bottom · 1 to 4 watch things, 5 and 6 watch people</caption>
          <thead><tr><th scope="col">Layer</th><th scope="col">Source</th><th scope="col">What it sees</th></tr></thead>
          <tbody>
            {stack.map(([n, name, src, sees]) => (
              <tr class:list={[n === '06' && 'hot']}>
                <th scope="row"><span class="mono ln">{n}</span> <span class="lname">{name}</span></th>
                <td>{src}</td>
                <td>{sees}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="c-a prose">
        <p>Layers one to four are about infrastructure, traffic and objects. They move markets and they interest militaries, but on their own they rarely name anyone. Layers five and six are about bodies. The rest of this edition walks up the stack in order, and corrects the version of it that circulates.</p>
      </div>
    </Section>

    <Section n="02" title="Structure" ground="bottle" acid id="structure">
      <div class="c-a prose">
        <p>Shodan is a search engine for machines. It crawls the internet and indexes every device that answers: servers, webcams, routers, building controllers, industrial equipment. You can search it by port, by product, by country, by the network that owns the address. <span class="cite">{c('shodan')}</span></p>
        <p>It is the base map. It tells you where the infrastructure is and what it runs. It does not tell you who is using it. A camera on Shodan is a camera, not a person.</p>
      </div>
    </Section>

    <Section n="03" title="Network" id="network">
      <div class="c-a prose">
        <p class="num figure fig-m" aria-hidden="true">90%</p>
        <p>NetFlow is the metadata of internet traffic. It records which address talked to which, when, on what port, and how much. It doesn’t record what was said. <span class="cite">{c('iapp')}</span></p>
        <p>That makes it sound harmless until you see the scale it is sold at. Team Cymru’s Augury product draws on 550 collection points worldwide and adds at least 100 billion records a day. Contracting records reviewed by Vice put its reach at about 90 percent of global internet traffic. Its buyers included several branches of the US military. <span class="cite">{c('iapp')}</span></p>
      </div>
      <figure class="c-b field flow" aria-label="An illustrative flow record, with documentation addresses, not real traffic">
        <figcaption class="mono">Illustrative flow record · documentation addresses, not real traffic</figcaption>
        <p class="mono-b rec"><span>SRC 203.0.113.7</span> <span>DST 198.51.100.24</span> <span>PORT 443</span> <span>BYTES 18,442</span> <span>T 14:02:11</span></p>
        <p class="note">There’s no content in it, only who, where, when and how much.</p>
      </figure>
    </Section>

    <Section n="04" title="Attention" ground="bottle" id="attention">
      <div class="c-a prose">
        <p class="num figure fig-l" aria-hidden="true">$10,000,000</p>
        <p>Panels estimate what people download, open and stream. Investment firms buy the estimates because app usage moves before revenue does, so a good panel lets a fund see a quarter before the company reports it.</p>
        <p>The first securities-fraud case against an alternative-data vendor came out of this layer. On 14 September 2021 the SEC settled with App Annie and its co-founder, Bertrand Schmitt. App Annie had told the companies sharing their app data that it would be aggregated and anonymised. From late 2014 to mid-2018 it used the non-aggregated, non-anonymised data to adjust the estimates it sold to trading firms, while telling those firms its process respected the consents it had obtained. The firm paid $10 million. Schmitt paid $300,000 and accepted a three-year bar from serving as an officer or director of a public company. <span class="cite">{c('sec')}</span></p>
        <p>The lesson for anyone building on this stack is that the legal risk lives in provenance, not in the model. A clean model trained on dirty data is a dirty product.</p>
      </div>
    </Section>

    <Section n="05" title="Orbit" acid id="orbit">
      <div class="c-a prose">
        <p>The most famous alternative dataset is also the most innocent. Satellites photograph retailers’ parking lots, and software counts the cars.</p>
        <p>Researchers at Berkeley Haas studied 4.8 million such images from RS Metrics, later combined with Orbital Insight, covering 67,000 stores belonging to 44 major US retailers from 2011 to 2017. Funds with the data earned 4 to 5 percent in the three days around earnings announcements. The edge was largest on the short side: funds bet against retailers heading for bad quarters while individual investors, who can see short interest only twice a month and with a lag, were buying the same stocks. <span class="cite">{c('haas')}</span></p>
        <p>Nobody in a parking lot is identified. That is why this layer is legal almost everywhere, and why it is the version funds talk about in public.</p>
      </div>
      <figure class="c-b field lots" aria-label="Illustration: two parking lots of 100 spaces, Quarter A 82 percent full, Quarter B 41 percent full">
        <figcaption class="mono">Illustration · two lots, two quarters</figcaption>
        {lots.map(([q, n, spaces]) => (
          <div class="lot-wrap">
            <p class="mono-b">{q} · {n}% full</p>
            <div class="lot" aria-hidden="true">{spaces.map((t) => (<span class:list={['sp', t && 'car']}></span>))}</div>
          </div>
        ))}
      </figure>
    </Section>

    <Section n="06" title="The device" ground="bottle" id="device">
      <div class="c-a prose">
        <p>Every ad inside a free app is sold in an auction that lasts a fraction of a second. To run it, the app broadcasts a bid request. Depending on permissions, that request can carry the phone’s advertising ID, GPS coordinates, IP address, device details, inferred interests and the app in use. Every bidder receives it, including the ones that lose. EFF’s summary is blunt: once data is broadcast this way, “it’s almost impossible to know who receives it or control how it’s used.” <span class="cite">{c('eff')}</span></p>
        <p>The losing bidders are the business. A company can join auctions it never intends to win, keep the requests and sell what it collects. This is called bidstream data.</p>
      </div>
      <figure class="c-full field fan" aria-label="One bid request, from a phone through an exchange to twelve bidders. One wins the ad. Eleven keep the data.">
        <figcaption class="mono">One bid request, twelve bidders · illustration</figcaption>
        <div class="fan-row" aria-hidden="true">
          <span class="node phone mono-b">Phone</span>
          <span class="wire"></span>
          <span class="node mono-b">Exchange</span>
          <span class="wire"></span>
          <ol class="bidders">
            {bidders.map((won, i) => (
              <li class:list={[won && 'won']}><span class="mono">{String(i + 1).padStart(2, '0')}</span> {won ? 'wins the ad' : 'keeps the data'}</li>
            ))}
          </ol>
        </div>
        <p class="mono note">One wins the ad. Eleven keep the data.</p>
      </figure>
      <dl class="c-full ledger-stats">
        <dt class="num">About 1,000,000,000 phones.</dt>
        <dd>Gravy Analytics and its subsidiary Venntel say they gather more than 17 billion signals a day from about a billion smartphones. <span class="cite">{c('record')}</span></dd>
        <dt class="num">More than 500,000,000 advertising IDs</dt>
        <dd>matched to precise location by Mobilewalla between 2018 and 2020, according to the FTC. An estimated 60 percent of its data came from ad auctions. <span class="cite">{c('record', 'eff')}</span></dd>
        <dt class="num">More than 30,000,000 location points</dt>
        <dd>in one sample leaked from Gravy Analytics in January 2025, including devices at the White House, the Kremlin, Vatican City and military bases. Apps named in the data included dating, fitness and transit apps. <span class="cite">{c('tcgravy')}</span></dd>
      </dl>
    </Section>

    <Section n="07" title="What the bid request does not carry" acid id="overstated">
      <div class="c-a prose">
        <p class="mono reg">Correction</p>
        <p>The popular telling of this stack overstates layer five in four ways.</p>
        <p><strong>Card purchases.</strong> The claim that bidstream data shows “what they purchase via credit-card point-of-sale systems” is wrong. Transaction data is a separate product, sold from card and bank panels. A bid request carries the ID, location, IP, device and app. It doesn’t carry your receipt. <span class="cite">{c('eff')}</span></p>
        <p><strong>A guaranteed iPhone ID.</strong> Since Apple’s App Tracking Transparency prompt in 2021, an app has to ask before it can use the iPhone’s advertising ID. Measured opt-in rates sit at roughly 35 to 50 percent globally, depending on whose panel you trust and which kind of app is asking. Many iPhones in the auction show no ID at all. <span class="cite">{c('moburst')}</span></p>
        <p><strong>Always GPS.</strong> Much of the leaked Gravy data turned out to be location inferred from IP addresses rather than satellite fixes. Plenty of points in these datasets are a city block wide, not a doorstep. <span class="cite">{c('tcgravy')}</span></p>
        <p><strong>But Android.</strong> Google announced in October 2025 that it was winding down Privacy Sandbox, its planned replacement for the Android advertising ID. The ID stays on unless the user deletes it. <span class="cite">{c('playio')}</span></p>
        <p>None of this makes the layer weak. It makes it uneven, and an analyst who treats it as complete will be confidently wrong about the people it misses.</p>
      </div>
    </Section>

    <Section n="08" title="The night pin" ground="bottle" id="pin">
      <div class="c-a prose">
        <p>An advertising ID is a long random string. It is pseudonymous, not anonymous, and it stops being even that the moment you ask where it sleeps.</p>
        <p>A phone that comes to rest at the same coordinate between 22:00 and 06:00, night after night, has a home. A home has an address. An address has registered voters. That single lookup, from coordinate to address to voter record, is where a string of letters becomes a name, a year of birth, often a party and a voting history.</p>
        <p>This is the night pin. Everything above it in this edition is context. This is the mechanism.</p>
      </div>
      <figure class="c-full field clock" aria-label="Illustration: one phone's pings around a 24-hour clock. By day they scatter; between 22:00 and 06:00 they gather at one point, the night pin, which leads to a home coordinate, a street address, a name, a year of birth, a party and a turnout history.">
        <figcaption class="mono">Illustration · one phone, 24 hours · the arc marks 22:00 to 06:00</figcaption>
        <div class="clock-row">
          <svg viewBox="0 0 400 400" aria-hidden="true">
            <circle cx={CX} cy={CY} r={RAD} fill="none" stroke="#00B24F" stroke-width="1.5" />
            {ticks.map(([[x1, y1], [x2, y2]]) => (<line x1={f1(x1)} y1={f1(y1)} x2={f1(x2)} y2={f1(y2)} stroke="#00B24F" stroke-width="1.5" />))}
            <path d={`M ${f1(AX)} ${f1(AY)} A ${RAD} ${RAD} 0 0 1 ${f1(BX)} ${f1(BY)}`} fill="none" stroke="#FFFFFF" stroke-width="4" />
            {hours.map(([t, x, y]) => (<text x={f1(x)} y={f1(y + 7)} text-anchor="middle" class="svg-t">{t}</text>))}
            {day.map(([x, y]) => (<circle cx={f1(x)} cy={f1(y)} r="4.5" fill="#00B24F" />))}
            {night.map(([x, y]) => (<circle cx={f1(x)} cy={f1(y)} r="3" fill="#FFFFFF" />))}
            <line x1={f1(PX + 28)} y1={f1(PY)} x2="400" y2={f1(PY)} stroke="#FFFFFF" stroke-width="1.5" />
            <circle cx={f1(PX)} cy={f1(PY)} r="28" fill="none" stroke="#FF1F5A" stroke-width="2" />
            <circle cx={f1(PX)} cy={f1(PY)} r="5" fill="#FF1F5A" />
          </svg>
          <ol class="chain">
            {chain.map((s) => (<li>{s}</li>))}
          </ol>
        </div>
      </figure>
    </Section>

    <Section n="09" title="Four points" id="proof">
      <div class="c-a prose">
        <p class="num figure fig-m" aria-hidden="true">4 → 95%</p>
        <p>The idea that a location trail can be anonymised has been tested, and it failed. In 2013, researchers studying 15 months of mobility data for 1.5 million people found that four points in space and time were enough to single out 95 percent of them. That was at hourly resolution, using cell-tower locations, which is coarser than the GPS in a modern bid request. <span class="cite">{c('crowd')}</span></p>
        <p>In December 2019 the New York Times obtained a file of more than 50 billion location pings from over 12 million phones, covering several months of 2016 and 2017. Its reporters followed military officials, police and lawyers by name. One phone belonged to a Microsoft employee who visited an Amazon office and took a job there a month later. <span class="cite">{c('nyt')}</span></p>
        <p>That last example is the whole trading pitch in one sentence. It’s also why the pitch runs into the law.</p>
      </div>
      <figure class="c-b field hundred" aria-label="Of every 100 people, four points single out 95">
        <figcaption class="mono">Of every 100 people, four points single out 95 <span class="cite">{c('crowd')}</span></figcaption>
        <div class="cells-100" aria-hidden="true">{Array.from({ length: 100 }, (_, i) => (<span class:list={['px', !unlit.has(i) && 'lit']}></span>))}</div>
      </figure>
    </Section>

    <Section n="10" title="The voter file" ground="bottle" id="file">
      <div class="c-a prose">
        <p>A voter file is the most reliable identity list in American public life. Almost every state’s file carries name and home address. Many add party, voting history and year of birth. A few add phone numbers, sex or race. <span class="cite">{c('ncsl')}</span></p>
        <p>It is public, but it is not free to use however you like. According to the National Conference of State Legislatures:</p>
        <ul class="key">
          <li><span class="sw a" aria-hidden="true"></span><span><strong>29 states</strong> restrict use of the voter list to non-commercial purposes.</span></li>
          <li><span class="sw m" aria-hidden="true"></span><span><strong>9 more</strong> restrict it to election, political or government purposes.</span></li>
          <li><span class="sw d" aria-hidden="true"></span><span><strong>12</strong> are silent on use. NCSL’s survey records no state that expressly allows any use. <span class="cite">{c('ncsl')}</span></span></li>
        </ul>
        <p class="mono reg">Correction</p>
        <p>A trading desk is a commercial user. The popular pitch, which grounds bidstream profiles in voter files to sharpen trading signals, skips the fact that in 38 states the input is restricted against exactly that.</p>
      </div>
      <figure class="c-b field waffle-fig" aria-label="Fifty states: 29 restrict the voter list to non-commercial use, 9 to election, political or government use, 12 are silent on use">
        <figcaption class="mono">Fifty states, one cell each <span class="cite">{c('ncsl')}</span></figcaption>
        <div class="waffle" aria-hidden="true">{waffle.map((t) => (<span class:list={['w', t]}></span>))}</div>
      </figure>
    </Section>

    <Section n="11" title="Where the join is legal" acid id="legal">
      <div class="c-a prose">
        <p>The join is legal, and growing, in the place the voter file was built for: politics.</p>
        <p>On 18 June 2026, the ad-tech company Nexxen and the data firm L2 launched VoterMatch. It joins L2’s national voter file to Nexxen’s ad-auction logs so that campaigns can see which registered voters an ad reached and how often. Neither company disclosed the matching method or match rates. <span class="cite">{c('nexxen')}</span></p>
        <p>Layers five and six have also been combined in public, outside a campaign. In June 2020 Mobilewalla published the race, gender and age mix of protesters in New York, Los Angeles, Minneapolis and Atlanta, derived from phone data. Its founder said no agency had asked for it. <span class="cite">{c('mobilewalla')}</span> In December 2024 the FTC alleged that Mobilewalla had built audience segments of protesters and of women visiting health clinics, and its order bars the company from selling sensitive location data. <span class="cite">{c('record')}</span></p>
      </div>
    </Section>

    <Section n="12" title="The three trades" ground="bottle" id="trades">
      <div class="c-a prose">
        <p>The pitch that circulates offers three ways to turn the full stack into trading returns. Checked against the record:</p>
      </div>
      <div class="c-full trades">
        <div class="trade field">
          <p class="mono n">01</p>
          <p class="trade-t mono-b">Foot traffic</p>
          <p class="verdict display acid">Works.</p>
          <p class="note">Sold as counts per store, not per person. In 2019 Thasos offered quantitative hedge funds daily visit counts for more than 600,000 US properties, built from phone location data. The satellite studies show the same edge from orbit. <span class="cite">{c('thasos', 'haas')}</span></p>
        </div>
        <div class="trade field">
          <p class="mono n">02</p>
          <p class="trade-t mono-b">Named people</p>
          <p class="verdict display">Barred at the source.</p>
          <p class="note">Tracking specific people at offices and homes is what the FTC has spent two years shutting down. The Gravy, Venntel and Mobilewalla orders bar the sale of sensitive location data, and Mobilewalla’s explicitly covers data showing where people live. Kochava’s order, filed in May 2026, bars sale of sensitive location data without the consumer’s express consent. <span class="cite">{c('record', 'kochava')}</span> And a firm that trades on data obtained by breaking the promise under which it was shared is in App Annie’s position. <span class="cite">{c('sec')}</span></p>
        </div>
        <div class="trade field">
          <p class="mono n">03</p>
          <p class="trade-t mono-b">Voter blocks</p>
          <p class="verdict display">Unproven.</p>
          <p class="note">In 38 states the input is restricted against commercial use, and there is no published evidence that location-weighted voter blocks forecast elections better than polling. <span class="cite">{c('ncsl')}</span></p>
        </div>
      </div>
      <div class="c-a prose">
        <p>The legitimate trade is the boring one. The exotic trades are either illegal at the source or untested.</p>
      </div>
    </Section>

    <Section n="13" title="Who buys the whole stack" id="buyers">
      <div class="c-a prose">
        <p class="num figure fig-l" aria-hidden="true">$27,000,000</p>
        <p>If funds mostly buy aggregates, who buys at the level of a person? The public record answers it. States.</p>
      </div>
      <dl class="c-full defs">
        <div><dt class="mono-b">FBI.</dt><dd>A 2022 contract worth up to $27 million for 5,000 licences to Babel Street’s Locate X, which runs on Venntel’s location data. <span class="cite">{c('record')}</span></dd></div>
        <div><dt class="mono-b">DHS.</dt><dd>According to the ACLU, about 113,654 location points obtained over three days in 2018. <span class="cite">{c('record')}</span></dd></div>
        <div><dt class="mono-b">CBP.</dt><dd>A 2019 to 2021 pilot using “commercially available marketing location data”, including data sourced from ad auctions. CBP’s own document says “RTB-sourced location data is recorded when an advertisement is served.” <span class="cite">{c('eff')}</span></dd></div>
        <div><dt class="mono-b">ICE.</dt><dd>Bought the Webloc tool in 2025. It tracks millions of phones and can filter by advertising ID. <span class="cite">{c('eff')}</span></dd></div>
        <div><dt class="mono-b">The US military.</dt><dd>Several branches bought access to Augury’s NetFlow data. <span class="cite">{c('iapp')}</span></dd></div>
      </dl>
      <div class="c-a prose">
        <p>The intelligence community has said as much about itself. A January 2022 report by a senior advisory group to the Director of National Intelligence, declassified in June 2023, states that commercially available information “includes information on nearly everyone,” and that it could be used “to cause harm to an individual’s reputation, emotional well-being, or physical safety.” <span class="cite">{c('odni')}</span></p>
      </div>
    </Section>

    <Section n="14" title="The law" ground="bottle" id="law">
      <div class="c-a">
        <p class="num figure fig-m" aria-hidden="true">29.06.26</p>
      </div>
      <dl class="c-full defs">
        <div><dt class="mono-b">Decided.</dt><dd>On 29 June 2026 the Supreme Court held in Chatrie v. United States that police conducted a Fourth Amendment search when they obtained a person’s phone location data from Google. Justice Kagan wrote for the Court. Questions of warrant particularity and good faith went back to the lower courts. <span class="cite">{c('chatrie')}</span></dd></div>
        <div><dt class="mono-b">Not decided.</dt><dd>Whether buying the same kind of data is a search. The FBI’s position that purchased data needs no warrant has not been tested in court. <span class="cite">{c('tcfbi')}</span></dd></div>
        <div><dt class="mono-b">Pending.</dt><dd>The Government Surveillance Reform Act, introduced in March 2026, would require a court-authorised warrant before federal agencies buy Americans’ information from data brokers. <span class="cite">{c('tcfbi')}</span></dd></div>
        <div><dt class="mono-b">Settled.</dt><dd>The FTC’s orders against Gravy, Venntel and Mobilewalla, and the Kochava order filed in May 2026, restrict the sale of sensitive location data by those companies. They do not regulate the buyers. <span class="cite">{c('record', 'kochava')}</span></dd></div>
      </dl>
    </Section>

    {/* The View is signed by Jesse James. Its wording waits on the owner:
        the source marks it JESSE TO CONFIRM OR REWRITE BEFORE PUBLISHING. */}
    <Section n="15" title="View" id="view">
      <RoseField layers={behind} class="rose divider" />
      <div class="c-a prose">
        <p class="mono reg">View · Jesse James</p>
        <p class="mono-b">Opinion. Not reporting.</p>
        <p class="beat">Chatrie put a warrant in front of the data police ask for.</p>
        <p class="beat">Nothing stands in front of the data they buy.</p>
        <p class="beat acid">The cheapest warrant is a purchase order.</p>
      </div>
    </Section>

    <Section n="16" title="The off switch" ground="bottle" acid id="off">
      <div class="c-a prose">
        <p>Layer five is the only layer in this stack that you control directly, and it takes about a minute.</p>
      </div>
      <dl class="c-full defs">
        <div><dt class="mono-b">Android.</dt><dd>Settings, Privacy, Ads, Delete advertising ID. The exact path varies by manufacturer.</dd></div>
        <div><dt class="mono-b">iPhone.</dt><dd>Settings, Privacy &amp; Security, Tracking. Turn off Allow Apps to Request to Track.</dd></div>
        <div><dt class="mono-b">Every app.</dt><dd>Give location access only while the app is in use, and choose approximate location wherever the app still works with it. <span class="cite">{c('eff')}</span></dd></div>
      </dl>
      <div class="c-a prose">
        <p>That doesn’t remove you from the voter file, and it doesn’t touch the IP address every connection carries. It does take the most precise identifier out of the auction.</p>
      </div>
    </Section>

    <Section n="17" title="Sources" id="sources">
      <ol class="c-full sources">
        {sources.map((s, i) => (<li><span class="mono-b n">{String(i + 1).padStart(2, '0')}</span><span>{s}</span></li>))}
      </ol>
    </Section>

    <EditionEnd slug={ed.slug} />
  </main>
</Base>

<style is:global>
